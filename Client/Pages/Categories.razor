@page "/categories"
@using Shared
@using Client.Services
@inject AuthService AuthService
@inject ListingService ListingService
@inject IJSRuntime JS

<PageTitle>My Categories</PageTitle>

<h1>My Categories</h1>
<p class="text-muted">
    Your own category tree, used for every supplier and sales channel. Map each supplier category or tag to one of
    your categories once; imports then sort products automatically. Each category can also have its eBay category,
    which new listings and publishing use.
</p>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @messageCss">@message</div>
}

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link @(tab == "tree" ? "active" : "")" href="javascript:void(0)" @onclick='() => tab = "tree"'>Category tree</a></li>
    <li class="nav-item"><a class="nav-link @(tab == "map" ? "active" : "")" href="javascript:void(0)" @onclick="ShowMapping">Map supplier categories &amp; tags</a></li>
</ul>

@if (tab == "tree")
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Add a category</h5>
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small">Name</label>
                    <input class="form-control form-control-sm" @bind="newName" placeholder="e.g. Carbon Filters" />
                </div>
                <div class="col-md-5">
                    <label class="form-label small">Inside</label>
                    <select class="form-select form-select-sm" @bind="newParentId">
                        <option value="">(top level)</option>
                        @foreach (var c in categories ?? new())
                        {
                            <option value="@c.Id">@c.Path</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <button class="btn btn-sm btn-primary" @onclick="AddCategory" disabled="@busy">Add category</button>
                </div>
            </div>
        </div>
    </div>

    @if (categories == null)
    {
        <p><em>Loading...</em></p>
    }
    else if (!categories.Any())
    {
        <div class="alert alert-info">
            No categories yet. Add them above, or open <strong>Map supplier categories &amp; tags</strong> and use
            <em>Build my categories from this supplier</em> to start from a supplier's own categories.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th class="text-end" title="Products placed directly in this category">Products</th>
                        <th title="Used for new listings and publishing when a listing has no eBay category. Sub-categories inherit it.">eBay category</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in categories)
                    {
                        <tr>
                            <td style="padding-left: @(0.5 + c.Depth * 1.5)rem;">
                                @if (editingId == c.Id)
                                {
                                    <div class="d-flex gap-1 flex-wrap">
                                        <input class="form-control form-control-sm" style="max-width: 220px;" @bind="editName" />
                                        <select class="form-select form-select-sm" style="max-width: 280px;" @bind="editParentId">
                                            <option value="">(top level)</option>
                                            @foreach (var p in categories.Where(p => p.Id != c.Id && !p.Path.StartsWith(c.Path + " › ")))
                                            {
                                                <option value="@p.Id">@p.Path</option>
                                            }
                                        </select>
                                        <button class="btn btn-sm btn-primary" @onclick="() => SaveEdit(c)" disabled="@busy">Save</button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => editingId = null">Cancel</button>
                                    </div>
                                }
                                else
                                {
                                    @(c.Depth > 0 ? "└ " : "")<strong>@c.Name</strong>
                                }
                            </td>
                            <td class="text-end">@c.ProductCount</td>
                            <td>
                                <div class="d-flex gap-1 align-items-center flex-wrap">
                                    <input class="form-control form-control-sm" style="width: 90px;" placeholder="ID" value="@EbayId(c)" @onchange="e => ebayIds[c.Id] = e.Value?.ToString()" />
                                    <input class="form-control form-control-sm" style="width: 200px;" placeholder="eBay category name" value="@EbayName(c)" @onchange="e => ebayNames[c.Id] = e.Value?.ToString()" />
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => SaveEbay(c)" disabled="@busy">Save</button>
                                    <button class="btn btn-sm btn-outline-secondary" title="Ask eBay for the best category for this name" @onclick="() => SuggestEbay(c)" disabled="@busy">Suggest</button>
                                </div>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" @onclick="() => StartEdit(c)" disabled="@busy">Rename / move</button>
                                    <button class="btn btn-outline-danger" @onclick="() => DeleteCategory(c)" disabled="@busy">Delete</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
else
{
    <div class="row g-2 align-items-end mb-3">
        <div class="col-md-3">
            <label class="form-label small">Supplier</label>
            <select class="form-select form-select-sm" value="@supplier" @onchange="OnSupplierChanged">
                @foreach (var s in suppliers)
                {
                    <option value="@s.Code">@s.Name</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label small">Search</label>
            <input class="form-control form-control-sm" @bind="sourceFilter" @bind:event="oninput" placeholder="Category or tag name" />
        </div>
        <div class="col-md-3">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="unmappedOnly" @bind="unmappedOnly" />
                <label class="form-check-label small" for="unmappedOnly">Not mapped only</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="showTagTypes" @bind="showAllTags" />
                <label class="form-check-label small" for="showTagTypes">Show brand/promo tags too</label>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body py-2">
            <div class="fw-semibold mb-1">Build my categories from this supplier</div>
            <div class="small text-muted mb-2">
                Creates categories from the supplier's categories (each level of a path becomes a level) and, if ticked,
                sub-categories from its type tags (e.g. Eden <em>Carbon Filters</em> under <em>Ventilation</em>), then maps them.
                Existing categories with the same name are reused; existing mappings are kept. You can tidy up afterwards.
            </div>
            <div class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label class="form-label small">Create them inside</label>
                    <select class="form-select form-select-sm" @bind="importParentId">
                        <option value="">(top level)</option>
                        @foreach (var c in categories ?? new())
                        {
                            <option value="@c.Id">@c.Path</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="importTags" @bind="importTags" />
                        <label class="form-check-label small" for="importTags">Include type tags as sub-categories</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <button class="btn btn-sm btn-success" @onclick="ImportFromSupplier" disabled="@busy">Build categories</button>
                </div>
            </div>
        </div>
    </div>

    @if (sources == null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        var shown = FilteredSources.ToList();
        <p class="small text-muted mb-1">
            @sources.Count(s => s.CatalogCategoryId.HasValue) of @sources.Count(s => s.SourceType == CategorySourceTypes.Category || s.TagType == "type") mapped.
            When a product has both, the most specific (deepest) of its category's and tags' mappings wins.
            @if (shown.Count > MaxRows)
            {
                <span>Showing the first @MaxRows – use Search to find others.</span>
            }
        </p>
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Supplier category / tag</th>
                        <th class="text-end">Products</th>
                        <th title="Only 'type' tags are used for filtering and categories">Tag type</th>
                        <th>My category</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in shown.Take(MaxRows))
                    {
                        <tr class="@(s.CatalogCategoryId.HasValue || s.TagType is "brand" or "promo" or "ignore" ? "" : "table-warning")">
                            <td>
                                <span class="badge @(s.SourceType == CategorySourceTypes.Category ? "bg-primary" : "bg-secondary") me-1">@(s.SourceType == CategorySourceTypes.Category ? "Category" : "Tag")</span>
                                @s.Label
                            </td>
                            <td class="text-end">@s.ProductCount</td>
                            <td>
                                @if (s.TagId.HasValue)
                                {
                                    <select class="form-select form-select-sm" style="width: 110px;" value="@s.TagType" disabled="@busy" @onchange="e => SetTagType(s, e.Value?.ToString())">
                                        <option value="type">Type</option>
                                        <option value="brand">Brand</option>
                                        <option value="promo">Promo</option>
                                        <option value="ignore">Ignore</option>
                                    </select>
                                }
                            </td>
                            <td>
                                @if (s.SourceType == CategorySourceTypes.Category || s.TagType == "type")
                                {
                                    <select class="form-select form-select-sm" value="@(s.CatalogCategoryId?.ToString() ?? "")" disabled="@busy" @onchange="e => SaveMapping(s, e.Value?.ToString())">
                                        <option value="">(not mapped)</option>
                                        @foreach (var c in categories ?? new())
                                        {
                                            <option value="@c.Id">@c.Path</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <span class="small text-muted">Not used for categories</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private const int MaxRows = 150;

    private string tab = "tree";
    private bool busy;
    private string? message;
    private string messageCss = "alert-info";

    private List<CatalogCategoryDto>? categories;
    private string newName = string.Empty;
    private int? newParentId;
    private int? editingId;
    private string editName = string.Empty;
    private int? editParentId;
    private readonly Dictionary<int, string?> ebayIds = new();
    private readonly Dictionary<int, string?> ebayNames = new();

    private List<SupplierDto> suppliers = new();
    private string supplier = string.Empty;
    private List<SupplierCategorySourceDto>? sources;
    private string sourceFilter = string.Empty;
    private bool unmappedOnly;
    private bool showAllTags;
    private int? importParentId;
    private bool importTags = true;

    private IEnumerable<SupplierCategorySourceDto> FilteredSources => (sources ?? new())
        .Where(s => showAllTags || s.SourceType == CategorySourceTypes.Category || s.TagType == "type")
        .Where(s => !unmappedOnly || (!s.CatalogCategoryId.HasValue && (s.SourceType == CategorySourceTypes.Category || s.TagType == "type")))
        .Where(s => string.IsNullOrWhiteSpace(sourceFilter) || s.Label.Contains(sourceFilter.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthService.EnsureAuthenticatedAsync("/categories")) return;
        await LoadCategories();
        try
        {
            suppliers = await ListingService.GetSuppliersAsync(includeInactive: true);
            supplier = suppliers.FirstOrDefault()?.Code ?? string.Empty;
        }
        catch (Exception ex) { Show($"Could not load suppliers: {ex.Message}", false); }
    }

    private void Show(string text, bool ok) { message = text; messageCss = ok ? "alert-success" : "alert-danger"; }

    private async Task LoadCategories()
    {
        try
        {
            categories = await ListingService.GetCatalogCategoriesAsync();
            ebayIds.Clear();
            ebayNames.Clear();
        }
        catch (Exception ex)
        {
            categories = new();
            Show($"Could not load categories: {ex.Message}", false);
        }
    }

    private async Task Run(Func<Task> action, string? success = null)
    {
        busy = true;
        message = null;
        try
        {
            await action();
            if (success != null) Show(success, true);
        }
        catch (Exception ex) { Show(ex.Message, false); }
        finally { busy = false; }
    }

    // ---- tree

    private Task AddCategory() => Run(async () =>
    {
        if (string.IsNullOrWhiteSpace(newName)) throw new Exception("Give the category a name.");
        await ListingService.CreateCatalogCategoryAsync(new SaveCatalogCategoryRequest { Name = newName.Trim(), ParentId = newParentId });
        newName = string.Empty;
        await LoadCategories();
    }, "Category added.");

    private void StartEdit(CatalogCategoryDto c)
    {
        editingId = c.Id;
        editName = c.Name;
        editParentId = c.ParentId;
    }

    private Task SaveEdit(CatalogCategoryDto c) => Run(async () =>
    {
        await ListingService.UpdateCatalogCategoryAsync(c.Id, new SaveCatalogCategoryRequest { Name = editName, ParentId = editParentId, SortOrder = c.SortOrder });
        editingId = null;
        await LoadCategories();
    }, "Category saved.");

    private async Task DeleteCategory(CatalogCategoryDto c)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete '{c.Path}'? Its sub-categories move up a level, and its products become uncategorised (until mapped again).")) return;
        await Run(async () =>
        {
            await ListingService.DeleteCatalogCategoryAsync(c.Id);
            await LoadCategories();
        }, "Category deleted.");
    }

    private string? EbayId(CatalogCategoryDto c) => ebayIds.TryGetValue(c.Id, out var v) ? v : c.EbayCategoryId;
    private string? EbayName(CatalogCategoryDto c) => ebayNames.TryGetValue(c.Id, out var v) ? v : c.EbayCategoryName;

    private Task SaveEbay(CatalogCategoryDto c) => Run(async () =>
    {
        await ListingService.SetChannelCategoryAsync(c.Id, "eBay", new ChannelCategoryRequest { ExternalId = EbayId(c), ExternalName = EbayName(c) });
        await LoadCategories();
    }, $"eBay category saved for {c.Name}.");

    private Task SuggestEbay(CatalogCategoryDto c) => Run(async () =>
    {
        var best = (await ListingService.GetCategorySuggestionsAsync(c.Name)).FirstOrDefault()
                   ?? throw new Exception($"eBay had no suggestion for '{c.Name}'. Enter the ID yourself.");
        ebayIds[c.Id] = best.CategoryId;
        ebayNames[c.Id] = best.CategoryName;
    }, $"eBay suggests this for {c.Name} – click Save to keep it.");

    // ---- mapping

    private async Task ShowMapping()
    {
        tab = "map";
        if (sources == null) await LoadSources();
    }

    private async Task OnSupplierChanged(ChangeEventArgs e)
    {
        supplier = e.Value?.ToString() ?? string.Empty;
        await LoadSources();
    }

    private async Task LoadSources()
    {
        if (string.IsNullOrEmpty(supplier)) { sources = new(); return; }
        sources = null;
        try { sources = await ListingService.GetCategorySourcesAsync(supplier); }
        catch (Exception ex)
        {
            sources = new();
            Show($"Could not load {supplier} categories: {ex.Message}", false);
        }
    }

    private Task SaveMapping(SupplierCategorySourceDto s, string? value) => Run(async () =>
    {
        int? categoryId = int.TryParse(value, out var id) ? id : null;
        await ListingService.SaveCategoryMappingAsync(new SaveCategoryMappingRequest
        {
            Supplier = supplier, SourceType = s.SourceType, SourceValue = s.Value, CatalogCategoryId = categoryId
        });
        s.CatalogCategoryId = categoryId;
        await LoadCategories(); // product counts
    }, $"Saved. {s.Label} products were re-sorted.");

    private Task SetTagType(SupplierCategorySourceDto s, string? type) => Run(async () =>
    {
        if (s.TagId == null || string.IsNullOrEmpty(type)) throw new Exception("Choose a tag type.");
        await ListingService.SetTagTypeAsync(s.TagId.Value, type);
        s.TagType = type;
    }, $"'{s.Label}' is now a {type} tag.");

    private Task ImportFromSupplier() => Run(async () =>
    {
        var result = await ListingService.ImportCategoriesFromSupplierAsync(new ImportSupplierCategoriesRequest
        {
            Supplier = supplier, ParentId = importParentId, IncludeTags = importTags
        });
        await LoadCategories();
        await LoadSources();
        Show($"Created {result.CategoriesCreated} categories and {result.MappingsCreated} mappings; {result.ProductsCategorised} products are now in my categories.", true);
    });
}
