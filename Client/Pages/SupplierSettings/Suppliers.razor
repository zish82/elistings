@page "/suppliers"
@using Shared
@using Client.Services
@inject AuthService AuthService
@inject ListingService ListingService
@inject IJSRuntime JS

<PageTitle>Suppliers</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Suppliers, VAT &amp; Delivery</h3>
        <a href="/" class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>

    <p class="text-muted small">
        VAT settings decide how supplier prices are turned into your cost. Delivery options are what each supplier charges you to deliver;
        the listing editor picks the option matching the product's postage category (or the default) and adds it to the listing price.
    </p>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success") alert-dismissible">
            @message
            <button type="button" class="btn-close" @onclick='() => message = null'></button>
        </div>
    }

    @if (!canEdit)
    {
        <div class="alert alert-info py-2 small">View only – ask an Admin or Manager to change supplier, delivery or eBay fee settings.</div>
    }

    @* Listers see the settings but can't change them (the server refuses changes from Listers too). *@
    <fieldset disabled="@(!canEdit)" class="@(canEdit ? "" : "settings-readonly")">
    @if (fees != null)
    {
        <div class="card mb-4 shadow-sm border-primary">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>eBay fees <span class="text-muted small">(used to estimate fees and profit)</span></strong>
                <button class="btn btn-sm btn-primary" @onclick="SaveFees">Save eBay fees</button>
            </div>
            <div class="card-body">
                <p class="small text-muted">
                    eBay doesn't tell you the fee until an item sells, so the app estimates it from eBay's UK rate card for business
                    sellers (Feb 2026). Check eBay's fee page and update these when eBay changes its fees.
                    @if (fees.UpdatedAtUtc.HasValue)
                    {
                        <span>Last changed @fees.UpdatedAtUtc.Value.ToLocalTime().ToString("d MMM yyyy").</span>
                    }
                </p>
                <div class="row g-2">
                    <div class="col-md-2">
                        <label class="form-label small">Final value fee %</label>
                        <input type="number" step="0.01" class="form-control form-control-sm" @bind="fees.FinalValueFeePercent" />
                        <div class="small text-muted">of item + postage; most categories 12.9%</div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Per-order fee (≤ threshold)</label>
                        <input type="number" step="0.01" class="form-control form-control-sm" @bind="fees.PerOrderFeeSmall" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Per-order fee (above)</label>
                        <input type="number" step="0.01" class="form-control form-control-sm" @bind="fees.PerOrderFeeLarge" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Threshold £</label>
                        <input type="number" step="0.01" class="form-control form-control-sm" @bind="fees.PerOrderFeeThreshold" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Regulatory fee %</label>
                        <input type="number" step="0.01" class="form-control form-control-sm" @bind="fees.RegulatoryFeePercent" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Minimum profit £</label>
                        <input type="number" step="0.01" class="form-control form-control-sm" @bind="fees.MinProfit" />
                        <div class="small text-muted">warn before publishing below this</div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" id="vatRegistered" @bind="fees.VatRegistered" />
                            <label class="form-check-label small" for="vatRegistered">I'm VAT-registered</label>
                        </div>
                        <div class="small text-muted">
                            @(fees.VatRegistered
                                ? "VAT on fees and purchases is reclaimed; VAT is taken off the sale price."
                                : "Not registered: 20% VAT on eBay's fees is a cost; no VAT on sales.")
                        </div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">VAT rate %</label>
                        <input type="number" step="0.1" class="form-control form-control-sm" @bind="fees.VatRatePercent" />
                    </div>
                </div>

                <h6 class="mt-3">Category rates</h6>
                <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                    <button class="btn btn-sm btn-outline-primary" @onclick="LoadRateCard" disabled="@feesBusy">Load eBay UK rates (@EbayRateCardDate)</button>
                    <a class="small" href="https://www.ebay.co.uk/help/selling/fees-credits-invoices/fees-business-sellers?id=4809" target="_blank">eBay's business seller fees page</a>
                    <span class="vr"></span>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshCategories" disabled="@feesBusy">Download eBay categories</button>
                    <span class="small text-muted">
                        @(fees.EbayCategoryCount > 0
                            ? $"{fees.EbayCategoryCount:N0} categories, downloaded " + (fees.EbayCategoriesUpdatedAtUtc.HasValue ? fees.EbayCategoriesUpdatedAtUtc.Value.ToLocalTime().ToString("d MMM yyyy") : "")
                            : "Not downloaded – only exact category IDs below match. Download so every sub-category finds its top-level rate.")
                    </span>
                    @if (feesBusy)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                </div>
                <p class="small text-muted mb-1">
                    A listing uses the rate of its eBay category, or of the nearest parent category listed here (e.g. a Candles listing uses
                    <em>Home, Furniture &amp; DIY</em>). Tiers apply per item to the total sale. Categories not covered use the default rate above.
                </p>
                <div class="mb-2" style="max-width: 360px;">
                    <input class="form-control form-control-sm" placeholder="Filter rates (name or ID)" @bind="rateFilter" @bind:event="oninput" />
                </div>
                <div class="table-responsive" style="max-height: 420px; overflow-y: auto;">
                    <table class="table table-sm align-middle">
                        <thead class="sticky-top bg-white"><tr><th>eBay category ID</th><th>Name</th><th>Final value fee</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var r in fees.CategoryRates.Where(r => string.IsNullOrWhiteSpace(rateFilter)
                                         || (r.CategoryName ?? "").Contains(rateFilter.Trim(), StringComparison.OrdinalIgnoreCase)
                                         || r.CategoryId.Contains(rateFilter.Trim())))
                            {
                                <tr>
                                    <td class="font-monospace">@r.CategoryId</td>
                                    <td>@(r.CategoryName ?? "-")</td>
                                    <td>@r.Describe()</td>
                                    <td class="text-end text-nowrap">
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => EditRate(r)">Edit</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteRate(r)">Remove</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="row g-1 align-items-end mt-1" style="max-width: 900px;">
                    <div class="col-md-2"><label class="form-label small mb-0">Category ID</label><input class="form-control form-control-sm" placeholder="e.g. 46782" @bind="newRate.CategoryId" /></div>
                    <div class="col-md-3"><label class="form-label small mb-0">Name</label><input class="form-control form-control-sm" placeholder="e.g. Candles" @bind="newRate.CategoryName" /></div>
                    <div class="col-md-1"><label class="form-label small mb-0">Fee %</label><input type="number" step="0.01" class="form-control form-control-sm" @bind="newRate.FinalValueFeePercent" /></div>
                    <div class="col-md-2"><label class="form-label small mb-0">…up to £ (optional)</label><input type="number" step="0.01" class="form-control form-control-sm" @bind="newRate.Threshold1" /></div>
                    <div class="col-md-1"><label class="form-label small mb-0">then %</label><input type="number" step="0.01" class="form-control form-control-sm" @bind="newRate.Percent2" /></div>
                    <div class="col-md-2"><label class="form-label small mb-0">…up to £ (optional)</label><input type="number" step="0.01" class="form-control form-control-sm" @bind="newRate.Threshold2" /></div>
                    <div class="col-md-1"><label class="form-label small mb-0">then %</label><input type="number" step="0.01" class="form-control form-control-sm" @bind="newRate.Percent3" /></div>
                    <div class="col-md-2"><label class="form-label small mb-0" title="Per-order fee for orders up to the threshold, when lower in this category">Small-order fee £</label><input type="number" step="0.01" class="form-control form-control-sm" @bind="newRate.PerOrderFeeSmall" /></div>
                    <div class="col-md-3"><button class="btn btn-sm btn-outline-primary" @onclick="AddRate" disabled="@feesBusy">Add / update rate</button></div>
                </div>
            </div>
        </div>
    }

    @if (suppliers == null)
    {
        <div class="spinner-border spinner-border-sm"></div>
    }
    else
    {
        @foreach (var s in suppliers)
        {
            <div class="card mb-4 shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>@s.Name <span class="text-muted small">(@s.Code)</span></strong>
                    <button class="btn btn-sm btn-primary" @onclick="() => SaveSupplier(s)">Save supplier</button>
                </div>
                <div class="card-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-3">
                            <label class="form-label small">Name</label>
                            <input class="form-control form-control-sm" @bind="s.Name" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">Website host</label>
                            <input class="form-control form-control-sm" @bind="s.WebsiteHost" placeholder="example.co.uk" />
                        </div>
                        <div class="col-md-1">
                            <label class="form-label small" title="Starts every SKU, e.g. DSM-S16301">SKU prefix</label>
                            <input class="form-control form-control-sm" @bind="s.SkuPrefix" maxlength="6" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">VAT rate %</label>
                            <input type="number" step="0.1" class="form-control form-control-sm" @bind="s.VatRatePercent" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">Default margin %</label>
                            <input type="number" step="1" class="form-control form-control-sm" @bind="s.DefaultMarginPercent" />
                            <div class="form-check mt-1">
                                <input class="form-check-input" type="checkbox" id="usesup-@s.Id" @bind="s.UseSupplierSuggestedPrice" />
                                <label class="form-check-label small" for="usesup-@s.Id" title="Suggested price = the price on the supplier's website when known; products without one use cost + default margin.">Use website price</label>
                            </div>
                        </div>
                        <div class="col-md-2 d-flex flex-column justify-content-end">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="vat-@s.Id" @bind="s.PricesIncludeVat" />
                                <label class="form-check-label small" for="vat-@s.Id">Prices include VAT</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="active-@s.Id" @bind="s.IsActive" />
                                <label class="form-check-label small" for="active-@s.Id" title="Same as the switch on Supplier Feeds: disabled suppliers aren't imported or synced and are hidden in the app.">Enabled</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="bgsync-@s.Id" @bind="s.BackgroundSyncEnabled" />
                                <label class="form-check-label small" for="bgsync-@s.Id" title="Scheduled imports and stock checks. Off = only manual imports; publishing still works.">Enable background sync</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="uploadpics-@s.Id" @bind="s.RequireUploadedPictures" />
                                <label class="form-check-label small" for="uploadpics-@s.Id" title="Use when the supplier's website blocks this server's picture downloads (e.g. Safelincs on the live server). Listings can then only be published with pictures you upload yourself; the supplier's own pictures are ignored. Leave off locally to download them automatically.">Upload pictures manually</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small" for="feecat-@s.Id">eBay fee category (for estimates)</label>
                            <select id="feecat-@s.Id" class="form-select form-select-sm" @bind="s.FeeCategoryId">
                                <option value="">(default rate)</option>
                                @foreach (var r in (fees?.CategoryRates ?? new()).OrderBy(r => r.CategoryName))
                                {
                                    <option value="@r.CategoryId">@r.CategoryName – @r.Describe()</option>
                                }
                            </select>
                            <div class="small text-muted">Used for this supplier's products, and listings without an eBay category.</div>
                        </div>
                    </div>

                    <h6 class="mt-2">Delivery options <span class="small text-muted fw-normal">– what @s.Name charges you to deliver one order</span></h6>
                    <details class="small text-muted mb-2">
                        <summary>How delivery options work</summary>
                        <ul class="mb-0 mt-1">
                            <li><strong>Option name</strong> is what you pick in the listing's <em>Delivery Option</em> dropdown (e.g. "Standard Parcel").</li>
                            <li><strong>Cost</strong> is the supplier's charge. Tick <em>already includes VAT</em> only if the supplier's price includes VAT; otherwise VAT is added for you.</li>
                            <li><strong>Postage classes</strong> (optional) automatically pick this option for products in those classes. Leave blank if unsure.</li>
                            <li><strong>Default</strong> is used when no postage class matches – choose one per supplier.</li>
                            <li><strong>Active</strong> hides/shows the option on listings; <strong>List order</strong> sorts the dropdown (lower first).</li>
                        </ul>
                    </details>

                    @if (!s.DeliveryOptions.Any())
                    {
                        <div class="small text-muted mb-2">No delivery options yet.</div>
                    }

                    @foreach (var o in s.DeliveryOptions.OrderBy(o => o.SortOrder))
                    {
                        var key = OptionKey(o);
                        <div class="border rounded p-2 mb-2 @(o.Id == 0 ? "border-success" : "")">
                            <div class="row g-2 align-items-end">
                                <div class="col-md-3">
                                    <label class="form-label small mb-0">Option name <span class="text-danger">*</span></label>
                                    <input class="form-control form-control-sm" @bind="o.Name" placeholder="e.g. Standard Parcel" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small mb-0">Notes (optional)</label>
                                    <input class="form-control form-control-sm" @bind="o.Description" placeholder="e.g. Royal Mail 48, small items" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small mb-0">Cost £</label>
                                    <input type="number" step="0.01" min="0" class="form-control form-control-sm" @bind="o.Cost" />
                                </div>
                                <div class="col-md-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="incvat-@key" @bind="o.CostIncludesVat" />
                                        <label class="form-check-label small" for="incvat-@key">Cost already includes VAT</label>
                                    </div>
                                    <div class="small text-muted">= £@PricingMath.DeliveryIncVat(o, s).ToString("F2") inc VAT</div>
                                </div>
                                <div class="col-md-2 text-end">
                                    <button class="btn btn-sm btn-primary" @onclick="() => SaveOption(s, o)" disabled="@(optionBusy.Contains(key))">
                                        @(optionBusy.Contains(key) ? "Saving..." : o.Id == 0 ? "Add" : "Save")
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger ms-1" title="Delete" @onclick="() => DeleteOption(s, o)">&times;</button>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small mb-0">Use automatically for postage classes (optional, comma separated)</label>
                                    <input class="form-control form-control-sm" @bind="o.PostageCategories" placeholder="Leave blank if unsure" />
                                    @if (s.KnownPostageCategories.Any())
                                    {
                                        <div class="small text-muted mt-1">
                                            This supplier's classes:
                                            @foreach (var c in s.KnownPostageCategories)
                                            {
                                                <a href="javascript:void(0)" class="badge bg-light text-dark border me-1 text-decoration-none" @onclick="() => AddCategory(o, c)">+ @c</a>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="small text-muted mt-1">This supplier's products have no postage classes – leave blank and mark one option as Default.</div>
                                    }
                                </div>
                                <div class="col-md-2">
                                    <div class="form-check">
                                        <input type="radio" class="form-check-input" id="default-@key" name="default-@s.Id" checked="@o.IsDefault" @onchange="() => SetDefault(s, o)" />
                                        <label class="form-check-label small" for="default-@key">Default</label>
                                    </div>
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="active-@key" @bind="o.IsActive" />
                                        <label class="form-check-label small" for="active-@key">Active</label>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small mb-0">List order</label>
                                    <input type="number" class="form-control form-control-sm" @bind="o.SortOrder" />
                                </div>
                                <div class="col-md-2 small">
                                    @if (optionStatus.TryGetValue(key, out var st))
                                    {
                                        <span class="@(st.Error ? "text-danger" : "text-success")">@st.Text</span>
                                    }
                                    else if (o.Id == 0)
                                    {
                                        <span class="text-muted">Not saved yet – click Add.</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    <button class="btn btn-sm btn-outline-success" @onclick="() => AddOption(s)">+ Add delivery option</button>
                </div>
            </div>
        }

        @if (canEdit)
        {
        <div class="card shadow-sm mb-5">
            <div class="card-header"><strong>Add supplier</strong></div>
            <div class="card-body row g-2">
                <div class="col-md-3"><input class="form-control form-control-sm" @bind="newSupplier.Code" placeholder="Code (e.g. NewSupplier)" /></div>
                <div class="col-md-3"><input class="form-control form-control-sm" @bind="newSupplier.Name" placeholder="Name" /></div>
                <div class="col-md-2"><input class="form-control form-control-sm" @bind="newSupplier.WebsiteHost" placeholder="website host" /></div>
                <div class="col-md-1"><input class="form-control form-control-sm" @bind="newSupplier.SkuPrefix" placeholder="SKU prefix" maxlength="6" /></div>
                <div class="col-md-3"><button class="btn btn-sm btn-success" @onclick="CreateSupplier">Add supplier</button></div>
                <div class="small text-muted">The code must match the supplier name used by its product feed. Product-page fetching needs a small code addition per supplier.</div>
            </div>
        </div>
        }
    }
    </fieldset>

    <style>
        /* View only: hide the action buttons (inputs are disabled by the fieldset). */
        .settings-readonly button, .settings-readonly .btn { display: none !important; }
    </style>
</div>

@code {
    private List<SupplierDto>? suppliers;
    private SupplierDto newSupplier = new();
    private string? message;
    private bool isError;

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthService.EnsureAuthenticatedAsync("/suppliers")) return;
        await Load();
    }

    // Admins and Managers can change settings; Listers see them read-only.
    private bool canEdit => AuthService.CurrentUser?.CanViewAllListings == true;

    private async Task Load()
    {
        try { suppliers = await ListingService.GetSuppliersAsync(includeInactive: true); }
        catch (Exception ex) { Show($"Could not load suppliers: {ex.Message}", true); suppliers = new(); }
        await LoadFees();
    }

    // ---- eBay fee settings
    private MarketplaceFeeSettingsDto? fees;
    private MarketplaceFeeCategoryRateDto newRate = new() { FinalValueFeePercent = 12.9m };
    private bool feesBusy;
    private string rateFilter = string.Empty;
    private const string EbayRateCardDate = "30 Sep 2026";

    private void EditRate(MarketplaceFeeCategoryRateDto r)
        => newRate = new MarketplaceFeeCategoryRateDto
        {
            CategoryId = r.CategoryId, CategoryName = r.CategoryName, FinalValueFeePercent = r.FinalValueFeePercent,
            Threshold1 = r.Threshold1, Percent2 = r.Percent2, Threshold2 = r.Threshold2, Percent3 = r.Percent3, PerOrderFeeSmall = r.PerOrderFeeSmall
        };

    private async Task LoadRateCard()
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Load eBay's UK business-seller rates ({EbayRateCardDate})? Those categories are updated to eBay's figures; rates you added for other categories are kept.")) return;
        feesBusy = true;
        try
        {
            Show(await ListingService.LoadUkFeeRateCardAsync());
            await LoadFees();
        }
        catch (Exception ex) { Show($"Could not load the rates: {ex.Message}", true); }
        finally { feesBusy = false; }
    }

    private async Task RefreshCategories()
    {
        feesBusy = true;
        Show("Downloading eBay categories (can take a minute)...");
        try
        {
            Show(await ListingService.RefreshEbayCategoriesAsync());
            await LoadFees();
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { feesBusy = false; }
    }

    private async Task LoadFees()
    {
        try { fees = await ListingService.GetMarketplaceFeesAsync(); }
        catch (Exception ex) { Show($"Could not load eBay fee settings: {ex.Message}", true); }
    }

    private async Task SaveFees()
    {
        if (fees == null) return;
        try
        {
            await ListingService.SaveMarketplaceFeesAsync(fees);
            await LoadFees();
            Show("eBay fees saved. Profit estimates use them straight away.");
        }
        catch (Exception ex) { Show($"Could not save eBay fees: {ex.Message}", true); }
    }

    private async Task AddRate()
    {
        try
        {
            await ListingService.SaveFeeCategoryRateAsync(newRate);
            newRate = new() { FinalValueFeePercent = fees?.FinalValueFeePercent ?? 12.9m };
            await LoadFees();
            Show("Category rate saved.");
        }
        catch (Exception ex) { Show($"Could not save the category rate: {ex.Message}", true); }
    }

    private async Task DeleteRate(MarketplaceFeeCategoryRateDto rate)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Remove the {rate.FinalValueFeePercent:0.##}% rate for category {rate.CategoryId}?")) return;
        try
        {
            await ListingService.DeleteFeeCategoryRateAsync(rate.Id);
            await LoadFees();
            Show("Category rate removed.");
        }
        catch (Exception ex) { Show($"Could not remove the category rate: {ex.Message}", true); }
    }

    private void Show(string text, bool error = false) { message = text; isError = error; }

    private async Task SaveSupplier(SupplierDto s)
    {
        try { await ListingService.UpdateSupplierAsync(s); Show($"{s.Name} saved."); }
        catch (Exception ex) { Show($"Save failed: {ex.Message}", true); }
    }

    private async Task CreateSupplier()
    {
        try
        {
            await ListingService.CreateSupplierAsync(newSupplier);
            newSupplier = new();
            await Load();
            Show("Supplier added.");
        }
        catch (Exception ex) { Show($"Add failed: {ex.Message}", true); }
    }

    private void SetDefault(SupplierDto s, SupplierDeliveryOptionDto selected)
    {
        foreach (var o in s.DeliveryOptions) o.IsDefault = o == selected;
    }

    // Per-option feedback shown next to the option (not only at the top of the page).
    private readonly Dictionary<string, (string Text, bool Error)> optionStatus = new();
    private readonly HashSet<string> optionBusy = new();
    private readonly System.Runtime.CompilerServices.ConditionalWeakTable<SupplierDeliveryOptionDto, string> newOptionKeys = new();

    private string OptionKey(SupplierDeliveryOptionDto o)
        => o.Id != 0 ? $"o{o.Id}" : newOptionKeys.GetValue(o, _ => "new" + Guid.NewGuid().ToString("N"));

    private void AddOption(SupplierDto s)
    {
        s.DeliveryOptions.Add(new SupplierDeliveryOptionDto
        {
            SupplierId = s.Id,
            Name = string.Empty,
            SortOrder = (s.DeliveryOptions.Any() ? s.DeliveryOptions.Max(o => o.SortOrder) : 0) + 10,
            CostIncludesVat = s.PricesIncludeVat,
            IsDefault = !s.DeliveryOptions.Any(o => o.IsDefault),
            IsActive = true
        });
    }

    private void AddCategory(SupplierDeliveryOptionDto o, string category)
    {
        var current = (o.PostageCategories ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        if (!current.Contains(category, StringComparer.OrdinalIgnoreCase)) current.Add(category);
        o.PostageCategories = string.Join(",", current);
    }

    private async Task SaveOption(SupplierDto s, SupplierDeliveryOptionDto o)
    {
        var key = OptionKey(o);
        optionStatus.Remove(key);

        if (string.IsNullOrWhiteSpace(o.Name))
        {
            optionStatus[key] = ("Enter an option name first.", true);
            return;
        }

        optionBusy.Add(key);
        try
        {
            if (o.Id == 0)
            {
                var created = await ListingService.AddDeliveryOptionAsync(s.Id, o);
                if (created == null) throw new Exception("The server didn't return the new option.");
                o.Id = created.Id;
                key = OptionKey(o);
            }
            else
            {
                await ListingService.UpdateDeliveryOptionAsync(o);
            }

            // The server keeps one default per supplier; mirror that here without reloading
            // (a reload would throw away unsaved edits on other options).
            if (o.IsDefault)
            {
                foreach (var other in s.DeliveryOptions.Where(x => x != o)) other.IsDefault = false;
            }
            optionStatus[key] = ("✓ Saved", false);
        }
        catch (Exception ex)
        {
            optionStatus[key] = ($"Not saved: {ex.Message}", true);
        }
        finally
        {
            optionBusy.Remove(OptionKey(o));
            optionBusy.Remove(key);
        }
    }

    private async Task DeleteOption(SupplierDto s, SupplierDeliveryOptionDto o)
    {
        if (o.Id != 0)
        {
            if (!await JS.InvokeAsync<bool>("confirm", $"Delete delivery option '{o.Name}'?")) return;
            try { await ListingService.DeleteDeliveryOptionAsync(o.Id); }
            catch (Exception ex) { Show($"Delete failed: {ex.Message}", true); return; }
        }
        s.DeliveryOptions.Remove(o);
    }
}
