@page "/products"
@using Shared
@using Client.Services
@inject AuthService AuthService
@inject ListingService ListingService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Products</PageTitle>

<h1>Products</h1>
<p class="text-muted">Browse supplier products and add them to your own listings.</p>

<div class="row g-2 mb-3">
    <div class="col-md-3">
        <label class="form-label">Supplier</label>
        <select class="form-select" value="@selectedSupplier" @onchange="OnSupplierChanged">
            @foreach (var supplier in suppliers)
            {
                <option value="@supplier">@supplier</option>
            }
        </select>
    </div>
    <div class="col-md-6">
        <label class="form-label">Search</label>
        <input class="form-control" @bind="search" @bind:event="oninput" @onkeyup="OnSearchKeyUp" placeholder="Search by title or SKU (press Enter)" />
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <button class="btn btn-outline-secondary w-100" @onclick="LoadProducts" disabled="@isLoading">Refresh</button>
    </div>
</div>

<div class="mb-3">
    <div class="fw-semibold mb-2">Available feeds for @selectedSupplier</div>
    <div class="d-flex gap-2 flex-wrap">
        @foreach (var feed in selectedFeeds)
        {
            <button class="btn btn-outline-primary" @onclick="() => SyncFeed(feed)" disabled="@(isBusy || importRunning)">
                @if (importRunning)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span><span>Importing...</span>
                }
                else
                {
                    <span>Import @feed.FeedType</span>
                }
            </button>
        }
        @if (!selectedFeeds.Any())
        {
            <span class="text-muted">No feeds configured for this supplier.</span>
        }
        @if (lastUpdatedAtUtc.HasValue)
        {
            <span class="small text-muted align-self-center">Last updated: @lastUpdatedAtUtc.Value.ToLocalTime().ToString("g")</span>
        }
    </div>
</div>
<div class="mb-3 d-flex gap-2 flex-wrap">
    <button class="btn btn-success" @onclick="AddSelected" disabled="@(!selectedIds.Any() || isBusy)">Add all selected to my listings</button>
    <button class="btn btn-outline-danger" @onclick="DeleteSelected" disabled="@(!selectedIds.Any() || isBusy)">Delete selected products</button>
</div>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert @statusCss">@statusMessage</div>
}

@if (!string.IsNullOrEmpty(importJobId))
{
    <div class="mb-3">
        <BulkJobProgress JobId="@importJobId" Title="Supplier catalogue import" OnFinished="OnImportFinished" />
    </div>
}

@if (!string.IsNullOrEmpty(enrichJobId))
{
    <div class="mb-3">
        <BulkJobProgress JobId="@enrichJobId" Title="Fetching descriptions & specifications from supplier" />
    </div>
}

@if (!string.IsNullOrEmpty(groupKey))
{
    <div class="alert alert-secondary d-flex justify-content-between align-items-center py-2 mb-2">
        <span>Showing all variants of <strong>@groupLabel</strong>. Tick them and use <em>Add all selected to my listings</em>.</span>
        <button type="button" class="btn btn-sm btn-primary" @onclick="ClearGroup">&larr; Back to product list</button>
    </div>
}

<div class="btn-group mb-2" role="group" aria-label="View">
    <button type="button" class="btn btn-sm @(view == "list" ? "btn-primary" : "btn-outline-primary")" @onclick="ShowList">Products</button>
    <button type="button" class="btn btn-sm @(view == "categories" ? "btn-primary" : "btn-outline-primary")" @onclick="ShowCategories">Categories</button>
</div>

@if (view == "categories")
{
    @if (isLoadingCategories)
    {
        <p><em>Loading categories...</em></p>
    }
    else if (!categorySummary.Any())
    {
        <div class="alert alert-warning">
            @if (categoriesInStockOnly)
            {
                <span>No in-stock products for @selectedSupplier. </span>
                <button type="button" class="btn btn-sm btn-outline-secondary py-0" @onclick="ShowAllStock">Show all products</button>
            }
            else if (grouping == ProductGrouping.SupplierCategory)
            {
                <span>No products for @selectedSupplier yet. Run an import first.</span>
            }
            else
            {
                <span>No tags yet. Re-run the @selectedSupplier import (tags are saved by imports; DropShipMall has none).</span>
            }
        </div>
    }
    else
    {
        <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
            <div class="btn-group btn-group-sm" role="group" aria-label="Group by">
                <button type="button" class="btn @(grouping == ProductGrouping.SupplierCategory ? "btn-secondary" : "btn-outline-secondary")" @onclick="() => SetGrouping(ProductGrouping.SupplierCategory)">Supplier categories</button>
                <button type="button" class="btn @(grouping == ProductGrouping.Tag ? "btn-secondary" : "btn-outline-secondary")" @onclick="() => SetGrouping(ProductGrouping.Tag)">Tags</button>
            </div>
            <span class="small text-muted">@categorySummary.Count groups for @selectedSupplier. Click one to show or hide its products.</span>
            <div class="form-check form-check-inline mb-0">
                <input class="form-check-input" type="checkbox" id="categoriesInStockOnly" checked="@categoriesInStockOnly" @onchange="OnCategoriesInStockChanged" />
                <label class="form-check-label small" for="categoriesInStockOnly">In stock only</label>
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary py-0" @onclick="CollapseAllCategories" disabled="@(!expandedCategories.Any())">Collapse all</button>
        </div>
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th class="text-end">Products</th>
                        <th class="text-end">In stock</th>
                        <th class="text-end">Already added</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in categorySummary)
                    {
                        var key = CategoryKey(c);
                        var expanded = expandedCategories.Contains(key);
                        <tr class="@(expanded ? "table-active" : "")" style="cursor: pointer;" @onclick="() => ToggleCategory(c)">
                            <td><span class="me-1">@(expanded ? "▾" : "▸")</span>@c.Label</td>
                            <td class="text-end">@c.Products</td>
                            <td class="text-end">@c.InStock</td>
                            <td class="text-end">@c.AlreadyAdded</td>
                            <td class="text-end"><span class="btn btn-sm btn-outline-secondary py-0">@(expanded ? "Hide products" : "View products")</span></td>
                        </tr>
                        @if (expanded)
                        {
                            <tr>
                                <td colspan="5" class="bg-light p-2">
                                    @if (!categoryProducts.TryGetValue(key, out var items))
                                    {
                                        <em class="small">Loading products...</em>
                                    }
                                    else if (!items.Any())
                                    {
                                        <span class="small text-muted">No products in this category.</span>
                                    }
                                    else
                                    {
                                        @ProductTable(items, sortable: false)
                                        @if (items.Count >= SupplierProductQuery.DefaultLimit)
                                        {
                                            <div class="small text-muted">First @SupplierProductQuery.DefaultLimit shown (highest price first).</div>
                                        }
                                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleCategory(c)">▴ Hide @c.Label</button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
}
else
{
@* Filters and sorting sit directly above the product list. *@
<div class="row g-2 mb-2 align-items-end p-2 border rounded bg-light">
    <div class="col-md-3">
        <label class="form-label small">Sort by</label>
        <select class="form-select form-select-sm" value="@sort" @onchange="OnSortChanged">
            <option value="@SupplierProductSort.PriceHighToLow">Supplier price: high to low</option>
            <option value="@SupplierProductSort.ProfitHighToLow">Approx. profit: high to low</option>
            <option value="@SupplierProductSort.PriceLowToHigh">Supplier price: low to high</option>
            <option value="@SupplierProductSort.StockHighToLow">Stock: high to low</option>
            <option value="@SupplierProductSort.Title">Title (A–Z)</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label small">Category</label>
        <select class="form-select form-select-sm" value="@category" @onchange="OnCategoryChanged">
            <option value="">All categories</option>
            @foreach (var c in categories)
            {
                <option value="@c">@c</option>
            }
            <option value="@SupplierProductQuery.Uncategorised">(No category)</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label small">Tag</label>
        <select class="form-select form-select-sm" value="@(tagId?.ToString() ?? "")" @onchange="OnTagChanged">
            <option value="">All tags</option>
            @foreach (var t in supplierTags)
            {
                <option value="@t.Id">@t.Name (@t.ProductCount)</option>
            }
            <option value="0">(No tag)</option>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label small">Min price £</label>
        <input type="number" step="0.01" min="0" class="form-control form-control-sm" @bind="minPrice" />
    </div>
    <div class="col-md-2">
        <label class="form-label small">Max price £</label>
        <input type="number" step="0.01" min="0" class="form-control form-control-sm" @bind="maxPrice" />
    </div>
    <div class="col-md-2">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="inStockOnly" @bind="inStockOnly" />
            <label class="form-check-label small" for="inStockOnly">In stock only</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="hideAdded" @bind="hideAdded" />
            <label class="form-check-label small" for="hideAdded">Hide already added</label>
        </div>
    </div>
    <div class="col-12 d-flex gap-2">
        <button class="btn btn-sm btn-primary" @onclick="LoadProducts" disabled="@isLoading">Apply filters</button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="ClearFilters" disabled="@isLoading">Clear</button>
        <span class="small text-muted align-self-center">
            @products.Count product(s)@(products.Count >= SupplierProductQuery.DefaultLimit ? $" (first {SupplierProductQuery.DefaultLimit} shown – narrow the filters to see more)" : "")
        </span>
    </div>
</div>

@if (isLoading)
{
    <p><em>Loading products...</em></p>
}
else if (!products.Any())
{
    <div class="alert alert-warning">
        @(HasActiveFilters ? "No products match these filters." : "No products found. Run catalogue sync first.")
    </div>
}
else
{
    @ProductTable(products, sortable: true)
}
}

@code {
    /// <summary>Clickable sort header in the list view; plain text inside categories (each is sorted by price).</summary>
    private RenderFragment Header(bool sortable, string label, string primary, string? alternate = null)
        => sortable ? SortHeader(label, primary, alternate) : PlainHeader(label);

    private RenderFragment PlainHeader(string label) => __builder =>
    {
        <span>@label</span>
    };

    /// <summary>Product grid, used by the list view and inside each expanded category.</summary>
    private RenderFragment ProductTable(List<SupplierProductListItemDto> items, bool sortable) => __builder =>
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th style="width: 36px;"><input type="checkbox" class="form-check-input" checked="@(items.Any() && items.All(p => selectedIds.Contains(p.Id)))" @onchange="e => ToggleSelectAll(items, e)" /></th>
                        <th>@Header(sortable, "Product", SupplierProductSort.Title)</th>
                        <th>Category</th>
                        <th>Image</th>
                        <th>SKU</th>
                        <th>@Header(sortable, "Stock", SupplierProductSort.StockHighToLow)</th>
                        <th>@Header(sortable, "Supplier Price", SupplierProductSort.PriceHighToLow, SupplierProductSort.PriceLowToHigh)</th>
                        <th>Suggested Price</th>
                        <th title="Suggested price minus supplier price. Before VAT, delivery and marketplace fees.">@Header(sortable, "Approx. Profit", SupplierProductSort.ProfitHighToLow)</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in items)
                    {
                        var images = string.IsNullOrWhiteSpace(product.ImageUrlsJson) ? Array.Empty<string>() : System.Text.Json.JsonSerializer.Deserialize<string[]>(product.ImageUrlsJson);
                        <tr id="product-@product.Id" class="@(product.Id == highlightProductId ? "table-warning" : "")">
                            <td><input type="checkbox" class="form-check-input" checked="@selectedIds.Contains(product.Id)" @onchange="() => ToggleSelection(product.Id)" /></td>
                            <td>
                                <a href="/products/@product.Id">@product.Title</a>
                                @if (product.GroupSize > 1 && product.GroupKey != null && groupKey != product.GroupKey)
                                {
                                    <div><a href="javascript:void(0)" class="small" @onclick="() => ShowGroup(product)">@product.GroupSize sizes / variants</a></div>
                                }
                                @if (!string.IsNullOrWhiteSpace(product.ProductUrl))
                                {
                                    <div><a class="small text-muted" href="@product.ProductUrl" target="_blank">Source</a></div>
                                }
                            </td>
                            <td>
                                @(string.IsNullOrWhiteSpace(product.CategoryName) ? "-" : product.CategoryName)
                                @if (product.Tags.Any())
                                {
                                    <div>
                                        @foreach (var tag in product.Tags)
                                        {
                                            <span class="badge bg-light text-dark border me-1">@tag</span>
                                        }
                                    </div>
                                }
                            </td>
                            <td>
                                @if (images != null && images.Length > 0)
                                {
                                    <img src="@images[0]" alt="Image" style="max-width: 48px; max-height: 48px; border-radius: 4px; border: 1px solid #ccc;" />
                                }
                                else if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl" alt="Image" style="max-width: 48px; max-height: 48px; border-radius: 4px; border: 1px solid #ccc;" />
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(product.SupplierSku) ? "-" : product.SupplierSku)</td>
                            <td>@(product.StockLevel?.ToString() ?? "-")</td>
                            <td>
                                @(product.SupplierPrice.HasValue ? $"£{product.SupplierPrice.Value:F2}" : "-")
                                @if (product.PriceIsEstimate)
                                {
                                    <span class="badge bg-warning text-dark" title="Trade price not confirmed yet (showing RRP)">est.</span>
                                }
                                @if (product.RrpPrice.HasValue && !product.PriceIsEstimate)
                                {
                                    <div class="small text-muted">RRP £@product.RrpPrice.Value.ToString("F2")</div>
                                }
                            </td>
                            <td>@(product.SuggestedPrice.HasValue ? $"£{product.SuggestedPrice.Value:F2}" : "-")</td>
                            <td>@(product.ApproxProfit.HasValue ? $"£{product.ApproxProfit.Value:F2}" : "-")</td>
                            <td>
                                @if (product.AlreadyAdded)
                                {
                                    <span class="badge bg-info text-dark">Already added</span>
                                }
                                else
                                {
                                    <span class="text-muted">Not added</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm" role="group">
                                    <button class="btn btn-outline-success" @onclick="() => AddSingle(product.Id, false)" disabled="@isBusy">Add to my listings</button>
                                    @if (product.AlreadyAdded)
                                    {
                                        <button class="btn btn-outline-secondary" @onclick="() => AddSingle(product.Id, true)" disabled="@isBusy">Add duplicate</button>
                                    }
                                    @if (product.ExistingListingId.HasValue)
                                    {
                                        <a class="btn btn-outline-primary" href="/edit-listing/@product.ExistingListingId.Value">Open listing</a>
                                    }
                                    <button class="btn btn-outline-danger" @onclick="() => DeleteSingle(product)" disabled="@isBusy">Delete</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    };

    private readonly List<SupplierProductListItemDto> products = new();
    private readonly List<SupplierFeedDto> feeds = new();
    private readonly HashSet<int> selectedIds = new();
    private List<string> suppliers = new();

    private string selectedSupplier = "DropShipMall";
    private string search = string.Empty;
    // Filters / sorting (applied on the server, so sorting covers all products, not just the loaded page).
    private string sort = SupplierProductSort.PriceHighToLow;
    private string category = string.Empty;
    private decimal? minPrice;
    private decimal? maxPrice;
    private bool inStockOnly;
    private bool hideAdded;
    private List<string> categories = new();

    // "list" = product grid, "categories" = products per supplier category.
    private string view = "list";
    private List<SupplierCategorySummaryDto> categorySummary = new();
    private string grouping = ProductGrouping.SupplierCategory;
    // Categories view: show only in-stock products (counts and expanded lists). Applies immediately.
    private bool categoriesInStockOnly;

    private Task ShowAllStock() => OnCategoriesInStockChanged(new ChangeEventArgs { Value = false });

    private async Task OnCategoriesInStockChanged(ChangeEventArgs e)
    {
        categoriesInStockOnly = e.Value is true;
        await LoadCategorySummary();
        foreach (var key in expandedCategories.ToList()) await LoadCategoryProducts(key);
    }

    // Tag filter.
    private List<ProductTagDto> supplierTags = new();
    private int? tagId;

    private async Task LoadFilterLists()
    {
        try { supplierTags = await ListingService.GetSupplierTagsAsync(selectedSupplier); }
        catch (Exception ex) { Console.WriteLine($"Could not load tags: {ex.Message}"); supplierTags = new(); }
    }

    private async Task OnTagChanged(ChangeEventArgs e)
    {
        tagId = int.TryParse(e.Value?.ToString(), out var id) ? id : null;
        await LoadProducts();
    }

    private async Task SetGrouping(string value)
    {
        grouping = value;
        CollapseAllCategories();
        await LoadCategorySummary();
    }
    private bool isLoadingCategories;

    private void ShowList() => view = "list";

    private async Task ShowCategories()
    {
        view = "categories";
        CollapseAllCategories();
        await LoadCategorySummary();
    }

    private async Task LoadCategorySummary()
    {
        isLoadingCategories = true;
        try { categorySummary = await ListingService.GetSupplierCategorySummaryAsync(selectedSupplier, grouping, categoriesInStockOnly); }
        catch (Exception ex)
        {
            statusCss = "alert-danger";
            statusMessage = $"Could not load categories: {ex.Message}";
            categorySummary = new();
        }
        finally { isLoadingCategories = false; }
    }

    // Expanded categories (several can be open at once) and their loaded products.
    private readonly HashSet<string> expandedCategories = new();
    private readonly Dictionary<string, List<SupplierProductListItemDto>> categoryProducts = new();

    /// <summary>Supplier grouping: the category name; my category / tag grouping: the id.</summary>
    private string CategoryKey(SupplierCategorySummaryDto c)
        => grouping == ProductGrouping.SupplierCategory ? c.Category ?? SupplierProductQuery.Uncategorised : (c.Id ?? 0).ToString();

    private async Task ToggleCategory(SupplierCategorySummaryDto c)
    {
        var key = CategoryKey(c);
        if (!expandedCategories.Add(key))
        {
            expandedCategories.Remove(key);
            categoryProducts.Remove(key);
            return;
        }
        await LoadCategoryProducts(key);
    }

    private void CollapseAllCategories()
    {
        expandedCategories.Clear();
        categoryProducts.Clear();
    }

    private async Task LoadCategoryProducts(string key)
    {
        try
        {
            var query = new SupplierProductQuery { Supplier = selectedSupplier, Sort = SupplierProductSort.PriceHighToLow, InStockOnly = categoriesInStockOnly };
            if (grouping == ProductGrouping.SupplierCategory) query.Category = key;
            else query.TagId = int.Parse(key);
            categoryProducts[key] = await ListingService.GetSupplierProductsAsync(query);
        }
        catch (Exception ex)
        {
            expandedCategories.Remove(key);
            statusCss = "alert-danger";
            statusMessage = $"Could not load products: {ex.Message}";
        }
    }

    /// <summary>After adding/deleting: refresh whichever view is showing.</summary>
    private async Task ReloadCurrentView()
    {
        if (view != "categories")
        {
            await LoadProducts();
            return;
        }
        await LoadCategorySummary();
        foreach (var key in expandedCategories.ToList()) await LoadCategoryProducts(key);
    }

    // Group view: all variants of one supplier product (also reachable as /products?group=...).
    [SupplyParameterFromQuery(Name = "group")] public string? GroupFromUrl { get; set; }
    [SupplyParameterFromQuery(Name = "supplier")] public string? SupplierFromUrl { get; set; }
    private string? groupKey;
    private string groupLabel = "this product";

    // Returning from a group view restores the exact list and scrolls back to the product you clicked.
    private List<SupplierProductListItemDto>? listBeforeGroup;
    private int? returnToProductId;
    private int? highlightProductId;
    private int? scrollToProductId;
    private bool scrollToTop;

    private async Task ShowGroup(SupplierProductListItemDto product)
    {
        view = "list"; // a group link inside an expanded category opens the list view
        listBeforeGroup = products.ToList();
        returnToProductId = product.Id;
        highlightProductId = null;
        groupKey = product.GroupKey;
        groupLabel = string.IsNullOrWhiteSpace(product.VariantName)
            ? product.Title
            : product.Title.Replace(" - " + product.VariantName, string.Empty);
        selectedIds.Clear();
        await LoadProducts();
        scrollToTop = true;
    }

    private async Task ClearGroup()
    {
        groupKey = null;
        selectedIds.Clear();
        if (!string.IsNullOrWhiteSpace(GroupFromUrl)) Navigation.NavigateTo("/products", replace: true);

        if (listBeforeGroup != null)
        {
            // Same list as before (no reload), so the position is exactly where you left it.
            products.Clear();
            products.AddRange(listBeforeGroup);
            listBeforeGroup = null;
            highlightProductId = scrollToProductId = returnToProductId;
        }
        else
        {
            await LoadProducts(); // opened directly via a group link
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (scrollToTop)
        {
            scrollToTop = false;
            await JS.InvokeVoidAsync("window.scrollTo", 0, 0);
        }
        else if (scrollToProductId.HasValue)
        {
            var id = scrollToProductId.Value;
            scrollToProductId = null;
            await JS.InvokeVoidAsync("eval", $"document.getElementById('product-{id}')?.scrollIntoView({{block:'center'}})");
        }
    }
    private bool HasActiveFilters => !string.IsNullOrWhiteSpace(search) || !string.IsNullOrWhiteSpace(category) || !string.IsNullOrEmpty(groupKey)
                                     || tagId.HasValue
                                     || minPrice.HasValue || maxPrice.HasValue || inStockOnly || hideAdded;
    private bool isLoading;
    private bool isBusy;
    private string? statusMessage;
    private string? enrichJobId;
    private string? importJobId;
    private bool importRunning;
    private DateTime? lastUpdatedAtUtc;

    /// <summary>Re-attaches to a running/recent import after a page refresh and shows when the supplier was last updated.</summary>
    private async Task LoadImportStatus()
    {
        try
        {
            var status = await ListingService.GetSupplierImportStatusAsync(selectedSupplier);
            lastUpdatedAtUtc = status.LastUpdatedAtUtc;
            importRunning = status.IsRunning;
            if (status.IsRunning && status.JobId != null) importJobId = status.JobId; // finished imports just show "Last updated"
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Could not load import status: {ex.Message}");
        }
    }

    private async Task OnImportFinished(BulkJobDto job)
    {
        importRunning = false;
        statusCss = job.Status == "Failed" ? "alert-danger" : "alert-success";
        await LoadCategories();
        await LoadFilterLists();
        await LoadProducts();
        await LoadImportStatus();
        if (view == "categories") await ReloadCurrentView();
        statusMessage = job.Status == "Failed" ? $"Import failed: {job.Message}" : $"Import finished. {job.Message}";
        StateHasChanged();
    }
    private string statusCss = "alert-info";

    private IEnumerable<SupplierFeedDto> selectedFeeds => feeds
        .Where(feed => feed.Supplier.Equals(selectedSupplier, StringComparison.OrdinalIgnoreCase))
        .OrderBy(feed => feed.FeedType);

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthService.EnsureAuthenticatedAsync("/products"))
        {
            return;
        }

        await LoadFeeds();
        if (!string.IsNullOrWhiteSpace(SupplierFromUrl)) selectedSupplier = SupplierFromUrl;
        if (!string.IsNullOrWhiteSpace(GroupFromUrl)) groupKey = GroupFromUrl;
        await LoadCategories();
        await LoadFilterLists();
        await LoadImportStatus();
        await LoadProducts();
        if (!string.IsNullOrEmpty(groupKey) && products.Any())
        {
            var first = products[0];
            selectedSupplier = first.Supplier;
            groupLabel = string.IsNullOrWhiteSpace(first.VariantName) ? first.Title : first.Title.Replace(" - " + first.VariantName, string.Empty);
        }
    }

    private async Task LoadCategories()
    {
        try { categories = await ListingService.GetSupplierProductCategoriesAsync(selectedSupplier); }
        catch (Exception ex) { Console.WriteLine($"Could not load categories: {ex.Message}"); categories = new(); }
    }

    private async Task OnSortChanged(ChangeEventArgs e)
    {
        sort = e.Value?.ToString() ?? SupplierProductSort.PriceHighToLow;
        await LoadProducts();
    }

    /// <summary>Clickable column header; a second click toggles to <paramref name="alternate"/> when given.</summary>
    private RenderFragment SortHeader(string label, string primary, string? alternate = null) => __builder =>
    {
        var active = sort == primary || (alternate != null && sort == alternate);
        var arrow = !active ? "" : sort == SupplierProductSort.PriceLowToHigh || sort == SupplierProductSort.Title ? " ▲" : " ▼";
        <a href="javascript:void(0)" class="text-decoration-none @(active ? "fw-bold" : "text-reset")" @onclick="() => SortBy(primary, alternate)">@label@arrow</a>
    };

    private async Task SortBy(string primary, string? alternate)
    {
        sort = sort == primary && alternate != null ? alternate : primary;
        await LoadProducts();
    }

    private async Task OnCategoryChanged(ChangeEventArgs e)
    {
        category = e.Value?.ToString() ?? string.Empty;
        await LoadProducts();
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadProducts();
    }

    private async Task ClearFilters()
    {
        search = string.Empty;
        category = string.Empty;
        tagId = null;
        minPrice = null;
        maxPrice = null;
        inStockOnly = false;
        hideAdded = false;
        groupKey = null;
        sort = SupplierProductSort.PriceHighToLow;
        await LoadProducts();
    }

    private async Task LoadFeeds()
    {
        try
        {
            feeds.Clear();
            feeds.AddRange(await ListingService.GetSupplierFeedsAsync());
            // Disabled suppliers (Supplier Feeds page) are hidden here.
            suppliers = feeds.Where(feed => feed.SupplierEnabled).Select(feed => feed.Supplier)
                .Where(supplier => !string.IsNullOrWhiteSpace(supplier))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(supplier => supplier)
                .ToList();
            if (!suppliers.Any()) suppliers.Add("DropShipMall");
            if (!suppliers.Contains(selectedSupplier, StringComparer.OrdinalIgnoreCase)) selectedSupplier = suppliers[0];
        }
        catch (Exception ex)
        {
            statusCss = "alert-danger";
            statusMessage = $"Could not load supplier feeds: {ex.Message}";
        }
    }

    private async Task OnSupplierChanged(ChangeEventArgs e)
    {
        selectedSupplier = e.Value?.ToString() ?? string.Empty;
        selectedIds.Clear();
        category = string.Empty;
        importJobId = null;
        importRunning = false;
        groupKey = null;
        tagId = null; // tags belong to a supplier
        await LoadCategories();
        await LoadFilterLists();
        await LoadImportStatus();
        await LoadProducts();
        CollapseAllCategories();
        if (view == "categories") await LoadCategorySummary();
    }

    private async Task LoadProducts()
    {
        isLoading = true;
        statusMessage = null;
        try
        {
            var loaded = await ListingService.GetSupplierProductsAsync(new SupplierProductQuery
            {
                // A group link (e.g. from the Dashboard) doesn't know the supplier; group keys are unique enough.
                // In a group view only the group applies, so every variant is shown whatever the filters are.
                Supplier = string.IsNullOrEmpty(groupKey) ? selectedSupplier : null,
                Search = string.IsNullOrEmpty(groupKey) ? search : null,
                Category = string.IsNullOrEmpty(groupKey) && !string.IsNullOrWhiteSpace(category) ? category : null,
                MinPrice = string.IsNullOrEmpty(groupKey) ? minPrice : null,
                MaxPrice = string.IsNullOrEmpty(groupKey) ? maxPrice : null,
                InStockOnly = string.IsNullOrEmpty(groupKey) && inStockOnly,
                HideAdded = string.IsNullOrEmpty(groupKey) && hideAdded,
                GroupKey = string.IsNullOrEmpty(groupKey) ? null : groupKey,
                TagId = string.IsNullOrEmpty(groupKey) ? tagId : null,
                Sort = sort
            });
            products.Clear();
            products.AddRange(loaded);
            selectedIds.RemoveWhere(id => products.All(p => p.Id != id));
        }
        catch (Exception ex)
        {
            statusCss = "alert-danger";
            statusMessage = $"Could not load products: {ex.Message}";
            products.Clear();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleSelection(int id)
    {
        if (selectedIds.Contains(id)) selectedIds.Remove(id);
        else selectedIds.Add(id);
    }

    private void ToggleSelectAll(List<SupplierProductListItemDto> items, ChangeEventArgs e)
    {
        var isChecked = (bool)(e.Value ?? false);
        foreach (var product in items)
        {
            if (isChecked) selectedIds.Add(product.Id);
            else selectedIds.Remove(product.Id);
        }
    }

    private async Task AddSingle(int productId, bool allowDuplicate)
    {
        isBusy = true;
        statusMessage = null;
        try
        {
            var result = await ListingService.AddSupplierProductsToMyListingsAsync(new List<int> { productId }, allowDuplicate);
            statusCss = "alert-success";
            statusMessage = $"Added {result.Added} listing(s). Skipped {result.SkippedAlreadyAdded}.";
            enrichJobId = result.EnrichmentJobId;
            await ReloadCurrentView();
        }
        catch (Exception ex)
        {
            statusCss = "alert-danger";
            statusMessage = $"Add failed: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task AddSelected()
    {
        if (!selectedIds.Any()) return;

        isBusy = true;
        statusMessage = null;
        try
        {
            var result = await ListingService.AddSupplierProductsToMyListingsAsync(selectedIds.ToList(), false);
            statusCss = "alert-success";
            statusMessage = $"Added {result.Added} listing(s). Skipped {result.SkippedAlreadyAdded}.";
            enrichJobId = result.EnrichmentJobId;
            selectedIds.Clear();
            await ReloadCurrentView();
        }
        catch (Exception ex)
        {
            statusCss = "alert-danger";
            statusMessage = $"Bulk add failed: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task SyncFeed(SupplierFeedDto feed)
    {
        isBusy = true;
        statusMessage = null;
        try
        {
            var result = await ListingService.SyncSupplierFeedAsync(feed.Id);
            if (result.IsSuccess && !string.IsNullOrEmpty(result.JobId))
            {
                // Long imports (e.g. Eden) continue in the background.
                importJobId = result.JobId;
                importRunning = true;
                statusCss = "alert-info";
                statusMessage = $"{feed.FeedType} import started. It takes a few minutes; you can keep using the app.";
            }
            else if (!result.IsSuccess)
            {
                statusCss = "alert-danger";
                statusMessage = result.ErrorMessage;
            }
            else
            {
                if (result.ProcessedRows == 0 || (result.Inserted == 0 && result.Updated == 0))
                {
                    statusCss = "alert-warning";
                    statusMessage = $"{feed.FeedType} finished but imported no products. Processed {result.ProcessedRows}, inserted {result.Inserted}, updated {result.Updated}.";
                }
                else
                {
                    statusCss = "alert-success";
                    statusMessage = $"{feed.FeedType} import complete. Processed {result.ProcessedRows}, inserted {result.Inserted}, updated {result.Updated}.";
                }
                await LoadProducts();
            }
        }
        catch (Exception ex)
        {
            statusCss = "alert-danger";
            statusMessage = $"Catalogue sync failed: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task DeleteSingle(SupplierProductListItemDto product)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete '{product.Title}' from supplier products?");
        if (!confirmed) return;

        isBusy = true;
        statusMessage = null;
        try
        {
            await ListingService.DeleteSupplierProductAsync(product.Id);
            selectedIds.Remove(product.Id);
            statusCss = "alert-success";
            statusMessage = "Product deleted.";
            await ReloadCurrentView();
        }
        catch (Exception ex)
        {
            statusCss = "alert-danger";
            statusMessage = $"Delete failed: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task DeleteSelected()
    {
        if (!selectedIds.Any()) return;
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete {selectedIds.Count} selected supplier products?");
        if (!confirmed) return;

        isBusy = true;
        statusMessage = null;
        try
        {
            var deleted = await ListingService.DeleteSupplierProductsAsync(selectedIds.ToList());
            selectedIds.Clear();
            statusCss = "alert-success";
            statusMessage = $"Deleted {deleted} product(s).";
            await ReloadCurrentView();
        }
        catch (Exception ex)
        {
            statusCss = "alert-danger";
            statusMessage = $"Delete failed: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }
}
