@page "/"
@using Shared
@using Client.Services
@inject AuthService AuthService
@inject ListingService ListingService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Dashboard</PageTitle>

<h1>My Listings</h1>

<div class="mb-3 d-flex justify-content-between align-items-center bg-light p-3 rounded border">
    <div>
        <a href="/create-listing" class="btn btn-primary">Create New Listing</a>
        <a href="/bulk-extract" class="btn btn-outline-primary ms-2"><i class="bi bi-box-arrow-in-down me-1"></i>Bulk Extract Category</a>
        <a href="/ebay-accounts" class="btn btn-outline-info ms-2">Manage eBay Accounts</a>
        <a href="/supplier-feeds" class="btn btn-outline-dark ms-2">Supplier Feeds</a>
        <a href="/suppliers" class="btn btn-outline-dark ms-2">Suppliers &amp; Delivery</a>
        <a href="/products" class="btn btn-outline-success ms-2">Products</a>
        @if (currentUser?.CanManageUsers == true)
        {
            <a href="/users" class="btn btn-outline-secondary ms-2">Users</a>
        }
        <input type="text" class="form-control form-control-sm d-inline-block ms-2" @bind="newAccountName" placeholder="Account label" style="width: 180px;" />
        <button class="btn btn-outline-info ms-2" @onclick="ConnectEbay">Connect Real eBay Account</button>
    </div>
    <div class="d-flex align-items-center">
        <input type="password" class="form-control form-control-sm me-2" @bind="manualToken" placeholder="Paste eBay User Token..." style="width: 250px;" />
        <input type="text" class="form-control form-control-sm me-2" @bind="newAccountName" placeholder="Account label" style="width: 180px;" />
        <button class="btn btn-sm btn-secondary" @onclick="SaveManualToken" disabled="@isSavingToken">Save Token</button>
    </div>
</div>
@if (!string.IsNullOrEmpty(tokenMessage))
{
    <div class="alert @tokenMessageCss py-2 small">@tokenMessage</div>
}

@if (ebayAccounts.Any())
{
    <div class="alert alert-success py-2 small">
        @($"{ebayAccounts.Count} eBay account(s) connected.")
        @if (ebayTokenExpiryUtc.HasValue)
        {
            <span class="ms-2">Default token expires: @ebayTokenExpiryUtc.Value.ToLocalTime().ToString("g")</span>
        }
    </div>

    <div class="card mb-3">
        <div class="card-body py-3">
            <h6 class="mb-3">eBay Accounts</h6>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Status</th>
                            <th>Expires</th>
                            <th>Actions</th>
                            <th class="text-end">Default</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var account in ebayAccounts)
                        {
                            <tr>
                                <td>@account.Name</td>
                                <td>
                                    <span class="badge @(account.IsConnected ? "bg-success" : "bg-warning text-dark")">
                                        @(account.IsConnected ? "Connected" : "Needs reconnect")
                                    </span>
                                </td>
                                <td>@(account.ExpiresAtUtc?.ToLocalTime().ToString("g") ?? "-")</td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button class="btn btn-outline-secondary" @onclick="() => RefreshAccountToken(account.Id, account.Name)">Refresh</button>
                                        <button class="btn btn-outline-info" @onclick="() => ConnectEbayAccount(account.Name)">Reconnect</button>
                                    </div>
                                </td>
                                <td class="text-end">
                                    @if (account.IsDefault)
                                    {
                                        <span class="badge bg-primary">Default</span>
                                    }
                                    else
                                    {
                                        <button class="btn btn-outline-primary btn-sm" @onclick="() => SetDefaultAccount(account.Id)">Make Default</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning py-2 small">No eBay account connected yet. Click "Connect Real eBay Account".</div>
}

@if (listings == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row g-2 align-items-end mb-3">
        <div class="col-sm-6 col-md-4 col-lg-3">
            <label for="ebayAccountFilter" class="form-label small text-muted">Filter by eBay account</label>
            <select id="ebayAccountFilter" class="form-select form-select-sm" value="@(selectedEbayAccountFilterId?.ToString() ?? string.Empty)" @onchange="OnEbayAccountFilterChanged">
                <option value="">All accounts</option>
                <option value="0">No account selected</option>
                @foreach (var account in ebayAccounts)
                {
                    <option value="@account.Id">@account.Name</option>
                }
                @foreach (var other in OtherUsersAccounts)
                {
                    <option value="@other.AccountId">@other.AccountName</option>
                }
            </select>
        </div>
        <div class="col-sm-6 col-md-4 col-lg-3">
            <div class="small text-muted">Showing @FilteredListings.Count of @listings.Count listing(s)</div>
            @if (OwnerFromUrl.HasValue)
            {
                <div class="small">Only @(listings.FirstOrDefault(l => l.OwnerUserId == OwnerFromUrl)?.OwnerEmail ?? "this user")'s listings · <a href="/">show all</a></div>
            }
            @if (DisabledSupplierCount > 0)
            {
                <div class="form-check small">
                    <input class="form-check-input" type="checkbox" id="showDisabledSuppliers" @bind="showDisabledSuppliers" />
                    <label class="form-check-label" for="showDisabledSuppliers"
                           title="Suppliers can be disabled on Supplier Feeds. Their listings are hidden here but stay on eBay.">
                        Show @DisabledSupplierCount listing(s) from disabled suppliers
                    </label>
                </div>
            }
        </div>
    </div>

    @if (groupFilter != null)
    {
        <div class="alert alert-secondary d-flex justify-content-between align-items-center py-2">
            <span>
                Showing listings for one product group (all its sizes/variants). Tick them and use <em>Bulk Publish to eBay</em>.
                <a href="/products?group=@Uri.EscapeDataString(groupFilter)" class="ms-2">See all variants in Products</a>
            </span>
            <button type="button" class="btn btn-sm btn-primary" @onclick="ClearGroup">&larr; Back to all listings</button>
        </div>
    }

    @if (selectedIds.Any())
    {
        <div class="alert alert-primary d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
                <strong>@selectedIds.Count</strong> items selected
                @if (ebayAccounts.Count > 1)
                {
                    <div class="small mt-1">
                        <span class="me-2">Publish to:</span>
                        @foreach (var account in ebayAccounts)
                        {
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox" id="bulk-acc-@account.Id" checked="@bulkAccountIds.Contains(account.Id)"
                                       @onchange="e => ToggleBulkAccount(account.Id, e.Value is true)" />
                                <label class="form-check-label" for="bulk-acc-@account.Id">@account.Name@(account.IsShared ? " (shared)" : "")</label>
                            </div>
                        }
                        <span class="text-muted">@(bulkAccountIds.Any() ? "Already published listings stay on their accounts too." : "None ticked: each listing's own account(s).")</span>
                    </div>
                }
            </div>
            <div>
                <button class="btn btn-primary btn-sm" @onclick="BulkPublish" disabled="@isBulkPublishing">
                    @if (isBulkPublishing)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Publishing...</span>
                    }
                    else
                    {
                        <span><i class="bi bi-cloud-upload me-1"></i>Bulk Publish to eBay</span>
                    }
                </button>
                <button class="btn btn-danger btn-sm ms-2" @onclick="BulkDelete" disabled="@isBulkDeleting">
                    @if (isBulkDeleting)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Deleting...</span>
                    }
                    else
                    {
                        <span><i class="bi bi-trash me-1"></i>Bulk Delete</span>
                    }
                </button>
            </div>
        </div>
    }
    
    @if (publishingId.HasValue && publishProgress != null)
    {
        <div class="alert alert-light border" role="status">
            <div class="fw-semibold mb-1"><span class="spinner-border spinner-border-sm me-2"></span>Publishing listing #@publishingId…</div>
            <PublishProgressPanel Progress="publishProgress" />
        </div>
    }

    @if (!string.IsNullOrEmpty(bulkPublishStatus))
    {
        <div class="alert @(bulkPublishStatus.Contains("failed", StringComparison.OrdinalIgnoreCase) ? "alert-danger" : publishWarnings.Count > 0 ? "alert-warning" : "alert-info") alert-dismissible fade show text-break" role="alert">
            @bulkPublishStatus
            @if (publishProgress != null && (publishWarnings.Count > 0 || bulkPublishStatus.Contains("failed", StringComparison.OrdinalIgnoreCase)))
            {
                <div class="mt-2 bg-white rounded p-2"><PublishProgressPanel Progress="publishProgress" /></div>
            }
            <button type="button" class="btn-close" @onclick="ClearPublishStatus"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(bulkPublishJobId))
    {
        <div class="mb-3 position-relative">
            <BulkJobProgress JobId="@bulkPublishJobId" Title="Bulk publish to eBay" OnFinished="OnBulkPublishFinished" />
            @if (!isBulkPublishing)
            {
                <button type="button" class="btn-close position-absolute top-0 end-0 m-2" @onclick='() => bulkPublishJobId = null'></button>
            }
        </div>
    }

    <table class="table align-middle">
        <thead>
            <tr>
                <th style="width: 40px;">
                    <input type="checkbox" class="form-check-input" @onchange="SelectAll" checked="@(FilteredListings.Any() && FilteredListings.All(l => selectedIds.Contains(l.Id)))" />
                </th>
                <th>Title</th>
                <th>Price</th>
                <th>Source Price</th>
                <th>Source Stock</th>
                @if (currentUser?.CanViewAllListings == true)
                {
                    <th>Owner</th>
                }
                <th>eBay Account</th>
                <th title="eBay category, with the supplier's own category below">Category</th>
                <th>Status</th>
                <th>eBay Item ID</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var listing in FilteredListings)
            {
                <tr id="listing-@listing.Id" class="@(listing.Id == highlightListingId ? "table-warning" : "")">
                    <td>
                        <input type="checkbox" class="form-check-input"
                               checked="@selectedIds.Contains(listing.Id)"
                               @onchange="() => ToggleSelection(listing.Id)" />
                    </td>
                    <td>
                        <div class="fw-bold">@listing.Title</div>
                        @if (groupFilter == null && GroupCount(listing.SupplierGroupKey) > 1)
                        {
                            <a href="javascript:void(0)" class="small" @onclick="() => ShowGroup(listing.SupplierGroupKey!, listing.Id)">Group: @GroupCount(listing.SupplierGroupKey) listings</a>
                        }
                    </td>
                    <td>
                        £@listing.TotalPrice.ToString("F2")
                        @if (listing.DeliveryCost.HasValue && listing.DeliveryCost > 0)
                        {
                            <div class="small text-muted">£@listing.Price.ToString("F2") + £@listing.DeliveryCost.Value.ToString("F2") delivery</div>
                        }
                        @if (listing.EstimatedProfit.HasValue)
                        {
                            <div class="small @(listing.BelowMinProfit ? "text-danger fw-semibold" : "text-success")"
                                 title="Estimated profit per sale after your cost, delivery and eBay fees (£@((listing.EstimatedFees ?? 0m).ToString("F2")))">
                                Est. profit £@listing.EstimatedProfit.Value.ToString("F2")
                            </div>
                        }
                    </td>
                    <td>@(listing.SourcePrice.HasValue ? $"£{listing.SourcePrice.Value:F2}" : "-")</td>
                    <td>@(listing.SourceStockLevel?.ToString() ?? "-")</td>
                    @if (currentUser?.CanViewAllListings == true)
                    {
                        <td>@listing.OwnerEmail</td>
                    }
                    <td>
                        @if (listing.Publications.Any())
                        {
                            @foreach (var pub in listing.Publications)
                            {
                                <span class="badge @(pub.Status == PublicationStatuses.Published ? "bg-info text-dark" : "bg-danger") me-1"
                                      title="@PublicationTitle(pub)">
                                    @pub.AccountName@(pub.Status == PublicationStatuses.Published ? "" : " ✖")
                                </span>
                            }
                        }
                        else if (!string.IsNullOrWhiteSpace(listing.EbayAccountName))
                        {
                            <span class="badge bg-light text-dark border" title="Not published yet">@listing.EbayAccountName</span>
                        }
                        else
                        {
                            <span class="text-muted small">Unassigned</span>
                        }
                    </td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(listing.CategoryId))
                        {
                            <span class="font-monospace small">@listing.CategoryId</span>
                            @if (!string.IsNullOrWhiteSpace(listing.CategoryName))
                            {
                                <div class="small text-muted">@listing.CategoryName</div>
                            }
                        }
                        else
                        {
                            <span class="text-muted small">eBay: not set</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(listing.SupplierCategory))
                        {
                            <div class="small"><span class="text-muted">Supplier:</span> @listing.SupplierCategory</div>
                        }
                    </td>
                    <td>
                        <span class="badge @(listing.Status == "Published" ? "bg-success" : "bg-warning text-dark")">
                            @listing.Status
                        </span>
                        @if (listing.QuantityZeroedAtUtc.HasValue)
                        {
                            <div><span class="badge bg-secondary" title="eBay quantity set to 0 on @listing.QuantityZeroedAtUtc.Value.ToLocalTime().ToString("g") because the supplier was disabled">eBay qty 0</span></div>
                        }
                        @if (listing.SupplierDisabled)
                        {
                            <div><span class="badge bg-light text-dark border">Supplier disabled</span></div>
                        }
                    </td>
                    <td><span class="font-monospace small">@listing.EbayItemId</span></td>
                    <td class="text-end">
                        <div class="btn-group" role="group">
                            <a href="/edit-listing/@listing.Id" class="btn btn-sm btn-outline-secondary">
                                Edit
                            </a>
                            <button class="btn btn-sm @(listing.Status == "Published" ? "btn-outline-success" : "btn-outline-primary")" 
                                    @onclick="() => Publish(listing.Id)" disabled="@(publishingId.HasValue)">
                                @if (publishingId == listing.Id)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                }
                                else
                                {
                                    @(listing.Status == "Published" ? "Re-sync" : "Publish")
                                }
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<ListingDto>? listings;
    private CurrentUserDto? currentUser;
    private List<EbayAccountDto> ebayAccounts = new();
    private int? selectedEbayAccountFilterId;

    private List<ListingDto> FilteredListings =>
        listings?
            .Where(listing =>
                !selectedEbayAccountFilterId.HasValue
                    || (selectedEbayAccountFilterId.Value == 0
                        ? !listing.EbayAccountId.HasValue && listing.Publications.Count == 0
                        : listing.EbayAccountId == selectedEbayAccountFilterId.Value
                          || listing.Publications.Any(p => p.AccountId == selectedEbayAccountFilterId.Value)))
            .Where(listing => !OwnerFromUrl.HasValue || listing.OwnerUserId == OwnerFromUrl.Value)
            .Where(listing => groupFilter == null || listing.SupplierGroupKey == groupFilter)
            .Where(listing => showDisabledSuppliers || !listing.SupplierDisabled)
            .ToList()
        ?? new List<ListingDto>();

    // Listings from disabled suppliers are hidden unless ticked.
    private bool showDisabledSuppliers;
    private int DisabledSupplierCount => listings?.Count(l => l.SupplierDisabled) ?? 0;

    // Group filter: listings made from variants of the same supplier product, so they can be published together.
    private string? groupFilter;

    private int GroupCount(string? key) => key == null ? 0 : listings?.Count(l => l.SupplierGroupKey == key) ?? 0;

    // Back from a group view scrolls to (and highlights) the listing you clicked.
    private int? returnToListingId;
    private int? highlightListingId;
    private int? scrollToListingId;
    private bool scrollToTop;

    private void ShowGroup(string key, int fromListingId)
    {
        groupFilter = key;
        returnToListingId = fromListingId;
        highlightListingId = null;
        selectedIds.Clear();
        scrollToTop = true;
    }

    private void ClearGroup()
    {
        groupFilter = null;
        selectedIds.Clear();
        highlightListingId = scrollToListingId = returnToListingId;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (scrollToTop)
        {
            scrollToTop = false;
            await JS.InvokeVoidAsync("window.scrollTo", 0, 0);
        }
        else if (scrollToListingId.HasValue)
        {
            var id = scrollToListingId.Value;
            scrollToListingId = null;
            await JS.InvokeVoidAsync("eval", $"document.getElementById('listing-{id}')?.scrollIntoView({{block:'center'}})");
        }
    }

    /// <summary>Hover text of an account badge: marketplace, eBay item number, last error.</summary>
    private static string PublicationTitle(ListingPublicationDto pub)
        => pub.Marketplace
           + (pub.ExternalListingId != null ? " item " + pub.ExternalListingId : string.Empty)
           + (pub.LastError != null ? " – last error: " + pub.LastError : string.Empty);

    /// <summary>?account=ID (from the Accounts overview): show only listings on that account.</summary>
    [SupplyParameterFromQuery(Name = "account")] public int? AccountFromUrl { get; set; }
    /// <summary>?owner=ID (from the Accounts overview): only that user's listings.</summary>
    [SupplyParameterFromQuery(Name = "owner")] public int? OwnerFromUrl { get; set; }

    /// <summary>Accounts that appear on visible listings but aren't this user's (Admins/Managers see other users' listings).</summary>
    private IEnumerable<ListingPublicationDto> OtherUsersAccounts => (listings ?? new List<ListingDto>())
        .SelectMany(l => l.Publications)
        .Where(p => ebayAccounts.All(a => a.Id != p.AccountId))
        .GroupBy(p => p.AccountId)
        .Select(g => g.First())
        .OrderBy(p => p.AccountName);

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthService.EnsureAuthenticatedAsync("/"))
        {
            return;
        }
        if (AccountFromUrl.HasValue) selectedEbayAccountFilterId = AccountFromUrl;

        currentUser = (await AuthService.GetSessionAsync()).User;
        // Managers and Admins see listings of disabled suppliers by default (Listers can tick to show them).
        showDisabledSuppliers = currentUser?.CanViewAllListings == true;
        HandleOAuthCallbackMessage();
        await LoadEbayAccounts();
        await LoadListings();
    }

    private DateTime? ebayTokenExpiryUtc;

    private async Task LoadEbayAccounts()
    {
        try
        {
            ebayAccounts = await ListingService.GetEbayAccountsAsync();
            ebayTokenExpiryUtc = ebayAccounts.FirstOrDefault(a => a.IsDefault)?.ExpiresAtUtc;
        }
        catch
        {
            ebayAccounts = new List<EbayAccountDto>();
            ebayTokenExpiryUtc = null;
        }
    }

    private void HandleOAuthCallbackMessage()
    {
        var currentUri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var status = GetQueryParam(currentUri.Query, "ebay");
        if (string.IsNullOrWhiteSpace(status)) return;

        var message = GetQueryParam(currentUri.Query, "message") ?? string.Empty;

        if (string.Equals(status, "connected", StringComparison.OrdinalIgnoreCase))
        {
            tokenMessageCss = "alert-success";
            tokenMessage = "eBay account connected successfully. You can now publish listings.";
        }
        else if (string.Equals(status, "error", StringComparison.OrdinalIgnoreCase))
        {
            tokenMessageCss = "alert-danger";
            tokenMessage = string.IsNullOrWhiteSpace(message) ? "eBay account connection failed." : $"eBay connection failed: {message}";
        }

        // Remove callback query params from address bar after reading them.
        Navigation.NavigateTo(currentUri.GetLeftPart(UriPartial.Path), replace: true);
    }

    private static string? GetQueryParam(string query, string key)
    {
        if (string.IsNullOrWhiteSpace(query)) return null;
        var trimmed = query.StartsWith("?") ? query.Substring(1) : query;
        foreach (var part in trimmed.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var idx = part.IndexOf('=');
            if (idx <= 0) continue;
            var k = Uri.UnescapeDataString(part.Substring(0, idx).Replace("+", " "));
            if (!string.Equals(k, key, StringComparison.OrdinalIgnoreCase)) continue;
            return Uri.UnescapeDataString(part.Substring(idx + 1).Replace("+", " "));
        }
        return null;
    }

    private async Task LoadListings()
    {
        try 
        {
            listings = await ListingService.GetListingsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading listings: {ex.Message}");
            listings = new List<ListingDto>();
        }
    }

    private int? publishingId;

    private PublishProgressDto? publishProgress;
    private List<string> publishWarnings = new();

    private async Task Publish(int id)
    {
        publishingId = id;
        bulkPublishStatus = "";
        publishProgress = null;
        publishWarnings = new();
        try
        {
            var published = await ListingService.PublishListingWithProgressAsync(id, async progress =>
            {
                publishProgress = progress;
                await InvokeAsync(StateHasChanged);
            });
            publishWarnings = published.PublishWarnings ?? new();
            await LoadListings();
            bulkPublishStatus = publishWarnings.Count > 0
                ? $"Listing #{id} published to eBay, with warnings: {string.Join(" | ", publishWarnings)}"
                : $"Listing #{id} published to eBay.";
        }
        catch (Exception ex)
        {
            bulkPublishStatus = $"Publishing listing #{id} failed: {ex.Message}";
        }
        finally
        {
            try { publishProgress = await ListingService.GetPublishProgressAsync(id) ?? publishProgress; }
            catch { /* display only */ }
            publishingId = null;
        }
    }

    private void ClearPublishStatus()
    {
        bulkPublishStatus = "";
        publishProgress = null;
        publishWarnings = new();
    }

    private HashSet<int> selectedIds = new();
    private bool isBulkPublishing = false;
    private bool isBulkDeleting = false;
    private string bulkPublishStatus = "";
    private string bulkDeleteStatus = "";

    private void ToggleSelection(int id)
    {
        if (selectedIds.Contains(id)) selectedIds.Remove(id);
        else selectedIds.Add(id);
    }

    private void OnEbayAccountFilterChanged(ChangeEventArgs e)
    {
        var rawValue = e.Value?.ToString();
        selectedEbayAccountFilterId = int.TryParse(rawValue, out var accountId) ? accountId : null;
        selectedIds.RemoveWhere(id => FilteredListings.All(listing => listing.Id != id));
    }

    private void SelectAll(ChangeEventArgs e)
    {
        if (!FilteredListings.Any()) return;
        bool isChecked = (bool)(e.Value ?? false);
        if (isChecked)
        {
            foreach (var listing in FilteredListings)
            {
                selectedIds.Add(listing.Id);
            }
        }
        else
        {
            foreach (var listing in FilteredListings)
            {
                selectedIds.Remove(listing.Id);
            }
        }
    }

    private async Task BulkPublish()
    {
        if (!selectedIds.Any()) return;
        isBulkPublishing = true;
        bulkPublishStatus = "";
        
        
        // Take a copy to avoid concurrent modification issues during iteration if needed
        var idsToProcess = selectedIds.ToList();

        // Warn before publishing listings whose estimated profit is below the minimum (eBay fee settings).
        var lowProfit = listings?.Where(l => idsToProcess.Contains(l.Id) && l.BelowMinProfit).ToList() ?? new();
        if (lowProfit.Any())
        {
            var names = string.Join("\n", lowProfit.Take(10).Select(l => $"• {l.Title} (est. £{l.EstimatedProfit:F2})"));
            var more = lowProfit.Count > 10 ? $"\n…and {lowProfit.Count - 10} more" : "";
            if (!await JS.InvokeAsync<bool>("confirm", $"{lowProfit.Count} selected listing(s) have an estimated profit below your minimum:\n{names}{more}\n\nPublish anyway?"))
            {
                isBulkPublishing = false;
                return;
            }
        }

        try
        {
            // Runs in the background on the server; progress is shown by <BulkJobProgress>.
            bulkPublishJobId = await ListingService.StartBulkPublishAsync(idsToProcess, bulkAccountIds.ToList());
            selectedIds.Clear();
        }
        catch (Exception ex)
        {
            bulkPublishStatus = $"Bulk publish failed to start: {ex.Message}";
            isBulkPublishing = false;
        }
    }

    private string? bulkPublishJobId;

    // Bulk publish: accounts ticked in the selection bar (none = each listing's own accounts).
    private HashSet<int> bulkAccountIds = new();

    private void ToggleBulkAccount(int accountId, bool on)
    {
        if (on) bulkAccountIds.Add(accountId);
        else bulkAccountIds.Remove(accountId);
    }

    private async Task OnBulkPublishFinished(BulkJobDto job)
    {
        isBulkPublishing = false;
        await LoadListings();
        StateHasChanged();
    }

    private async Task BulkDelete()
    {
        if (!selectedIds.Any()) return;

        // First confirmation
        var confirm = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete the selected listings?");
        if (!confirm) return;

        // If any selected are published, show a stronger warning
        var anyPublished = listings?.Where(l => selectedIds.Contains(l.Id) && string.Equals(l.Status, "Published", StringComparison.OrdinalIgnoreCase)).Any() ?? false;
        if (anyPublished)
        {
            var confirmPublished = await JS.InvokeAsync<bool>("confirm", "WARNING: Some selected listings are Published. Published listings will be marked as Deleted while Drafts will be permanently removed. Are you sure?");
            if (!confirmPublished) return;
        }

        isBulkDeleting = true;
        bulkDeleteStatus = "";

        try
        {
            var result = await ListingService.BulkDeleteAsync(selectedIds.ToList());
            bulkDeleteStatus = $"Bulk Delete complete. Marked: {result.Marked}, Deleted: {result.Deleted}";
            selectedIds.Clear();
            await LoadListings();
        }
        catch (Exception ex)
        {
            bulkDeleteStatus = $"Bulk Delete failed: {ex.Message}";
        }
        finally
        {
            isBulkDeleting = false;
        }
    }

    private string? manualToken;
    private string? newAccountName;
    private bool isSavingToken = false;
    private string? tokenMessage;
    private string tokenMessageCss = "alert-info";

    private async Task ConnectEbay()
    {
        tokenMessage = null;
        try
        {
            var loginUrl = await ListingService.GetEbayLoginUrlAsync("/", newAccountName);
            Navigation.NavigateTo(loginUrl, forceLoad: true);
        }
        catch (Exception ex)
        {
            tokenMessageCss = "alert-danger";
            tokenMessage = $"Could not start eBay login: {ex.Message}";
        }
    }

    private async Task ConnectEbayAccount(string accountName)
    {
        tokenMessage = null;
        try
        {
            var loginUrl = await ListingService.GetEbayLoginUrlAsync("/", accountName);
            Navigation.NavigateTo(loginUrl, forceLoad: true);
        }
        catch (Exception ex)
        {
            tokenMessageCss = "alert-danger";
            tokenMessage = $"Could not start eBay reconnect: {ex.Message}";
        }
    }

    private async Task RefreshAccountToken(int accountId, string accountName)
    {
        tokenMessage = null;
        try
        {
            await ListingService.RefreshEbayAccountAsync(accountId);
            await LoadEbayAccounts();
            tokenMessageCss = "alert-success";
            tokenMessage = $"Token refreshed for {accountName}.";
        }
        catch (Exception ex)
        {
            tokenMessageCss = "alert-warning";
            tokenMessage = $"Could not refresh {accountName}. Please use Reconnect. Details: {ex.Message}";
        }
    }

    private async Task SaveManualToken()
    {
        if (string.IsNullOrWhiteSpace(manualToken)) return;
        isSavingToken = true;
        tokenMessage = null;
        try
        {
            await ListingService.SetManualTokenAsync(manualToken, newAccountName);
            await LoadEbayAccounts();
            tokenMessageCss = "alert-success";
            tokenMessage = "Token saved successfully! You can now create and publish listings.";
            manualToken = "";
            newAccountName = "";
        }
        catch (Exception ex)
        {
            tokenMessageCss = "alert-danger";
            tokenMessage = $"Error saving token: {ex.Message}";
        }
        finally
        {
            isSavingToken = false;
        }
    }

    private async Task SetDefaultAccount(int accountId)
    {
        try
        {
            await ListingService.SetDefaultEbayAccountAsync(accountId);
            await LoadEbayAccounts();
        }
        catch (Exception ex)
        {
            tokenMessageCss = "alert-danger";
            tokenMessage = $"Error updating default account: {ex.Message}";
        }
    }
}

