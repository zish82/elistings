    private decimal DisplayedPrice => selectedVariant?.Price ?? listing.Price;
    // A variation without its own supplier cost uses the listing's.
    private decimal? DisplayedSourcePrice => selectedVariant?.SourcePrice ?? listing.SourcePrice;

    private void SetDisplayedPrice(decimal price)
    {
