    private decimal ListingTotal => PricingMath.ListingTotal(DisplayedPrice, listing.DeliveryCost, listing.IncludeDeliveryInPrice);

    private decimal? CostIncVat => PricingMath.CostIncVat(listing.SourcePrice, supplierContext?.Supplier);

    // The supplier website price belongs to the listing's product, so it isn't suggested for a variation with its own cost.
    private (decimal? Price, string? Source) SuggestedPick => PricingMath.SuggestPrice(DisplayedSourcePrice,
        selectedVariant?.SourcePrice != null ? null : supplierContext?.WebsitePrice, supplierContext?.Supplier);
    private decimal? SuggestedItemPrice => SuggestedPick.Price;

    // eBay fee estimate (settings on /suppliers), recalculated as the price/delivery/category change.
    private MarketplaceFeeSettingsDto? feeSettings;
    private FeeEstimate FeeEstimate => EstimateFor(DisplayedPrice, DisplayedSourcePrice);
    private FeeEstimate EstimateFor(decimal price, decimal? sourcePrice) => FeeMath.EstimateSale(price, listing.DeliveryCost, listing.IncludeDeliveryInPrice,
        sourcePrice, CategoryChain, supplierContext?.Supplier, feeSettings ?? new MarketplaceFeeSettingsDto());

    // The eBay category and its parents (fee rates are set on top-level categories); loaded when the category changes.
    private List<string>? categoryChain;
    private string? categoryChainFor;
    private IReadOnlyList<string>? CategoryChain
        => string.IsNullOrWhiteSpace(listing.CategoryId) ? null
           : categoryChainFor == listing.CategoryId.Trim() && categoryChain != null ? categoryChain
           : new List<string> { listing.CategoryId.Trim() };

    private async Task LoadCategoryChain()
    {
        var id = listing.CategoryId?.Trim();
        if (string.IsNullOrEmpty(id) || id == categoryChainFor) return;
        try
        {
            categoryChain = await ListingService.GetEbayCategoryChainAsync(id);
            categoryChainFor = id;
        }
        catch (Exception ex) { Console.WriteLine($"Could not load the eBay category's parents: {ex.Message}"); }
    }

    private void CopyExtras(ListingDto source)
    {
        listing.Marketplace = string.IsNullOrWhiteSpace(source.Marketplace) ? "eBay" : source.Marketplace;
        listing.DeliveryOptionName = source.DeliveryOptionName;
        listing.DeliveryCost = source.DeliveryCost;
        listing.IncludeDeliveryInPrice = true; // separate postage not implemented yet
        listing.ItemSpecifics = source.ItemSpecifics ?? new Dictionary<string, string>();
        listing.Barcode = source.Barcode;
        listing.SourceTitle = source.SourceTitle;
        listing.SupplierCategory = source.SupplierCategory;
    }

    /// <summary>Loads supplier VAT/delivery settings; on a listing without delivery yet, applies the suggested option.</summary>
    private async Task LoadSupplierContext()
    {
        try
        {
            supplierContext = Id.HasValue
                ? await ListingService.GetSupplierContextForListingAsync(Id.Value)
                : await ListingService.GetSupplierContextForUrlAsync(listing.SourceUrl);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Could not load supplier delivery options: {ex.Message}");
            supplierContext = null;
            return;
        }

        var match = DeliveryOptions.FirstOrDefault(o => o.Name == listing.DeliveryOptionName);
        if (match != null)
        {
            selectedDeliveryOptionId = match.Id;
        }
        else if (listing.DeliveryCost == null && supplierContext.SuggestedDeliveryOptionId.HasValue)
        {
            ApplyDeliveryOption(DeliveryOptions.FirstOrDefault(o => o.Id == supplierContext.SuggestedDeliveryOptionId));
        }
    }

    private void ApplyDeliveryOption(SupplierDeliveryOptionDto? option)
    {
        selectedDeliveryOptionId = option?.Id;
        if (option == null) return;
        listing.DeliveryOptionName = option.Name;
        listing.DeliveryCost = DeliveryGross(option);
    }

    private void OnDeliveryOptionChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            ApplyDeliveryOption(DeliveryOptions.FirstOrDefault(o => o.Id == id));
        }
        else
        {
            selectedDeliveryOptionId = null;
            listing.DeliveryOptionName = null; // custom: keep the typed cost
        }
    }

    private async Task FetchSupplierDetails()
    {
        if (!Id.HasValue) return;
        isFetchingDetails = true;
        detailsMessage = null;
        try
        {
            // Save unsaved edits first so the server only fills fields that are still empty.
            if (isQuillReady) listing.Description = await JS.InvokeAsync<string>("quillInterop.getHtml", quillElement);
            await ListingService.UpdateListingAsync(Id.Value, listing);

            var result = await ListingService.FetchSupplierDetailsAsync(Id.Value);
            if (result.Listing != null)
            {
                var updated = result.Listing;
                listing.Title = updated.Title;
                listing.Description = updated.Description;
                listing.Price = updated.Price;
                listing.Type = updated.Type;
                listing.Brand = updated.Brand;
                listing.Colour = updated.Colour;
                listing.ImageUrls = updated.ImageUrls ?? new List<string>();
                listing.SourceUrl = updated.SourceUrl;
                listing.SourcePrice = updated.SourcePrice;
                listing.SourceStockLevel = updated.SourceStockLevel;
                listing.SourceProductCode = updated.SourceProductCode;
                CopyExtras(updated);
                if (isQuillReady) await JS.InvokeVoidAsync("quillInterop.setHtml", quillElement, listing.Description ?? string.Empty);
                await LoadSupplierContext();
            }
            detailsMessage = result.Message;
        }
        catch (Exception ex)
        {
            detailsMessage = $"Fetching details failed: {ex.Message}";
        }
        finally
        {
            isFetchingDetails = false;
        }
