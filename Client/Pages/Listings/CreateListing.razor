    private IEnumerable<SupplierDeliveryOptionDto> DeliveryOptions
        => supplierContext?.Supplier?.DeliveryOptions.Where(o => o.IsActive).OrderBy(o => o.SortOrder) ?? Enumerable.Empty<SupplierDeliveryOptionDto>();

    private decimal DeliveryGross(SupplierDeliveryOptionDto o)
        => supplierContext?.Supplier == null ? o.Cost : PricingMath.DeliveryIncVat(o, supplierContext.Supplier);

    // Variations (edit page): the one picked drives the item price, listing total and profit shown in Price & Delivery.
    private IReadOnlyList<ListingVariantsEditor.Row> variantRows = Array.Empty<ListingVariantsEditor.Row>();
