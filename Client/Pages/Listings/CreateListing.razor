    protected override async Task OnInitializedAsync()
    {
        if (!await AuthService.EnsureAuthenticatedAsync(Navigation.ToBaseRelativePath(Navigation.Uri).Insert(0, "/")))
        {
            return;
        }

        await LoadEbayAccounts();
        try { feeSettings = await ListingService.GetMarketplaceFeesAsync(); }
        catch (Exception ex) { Console.WriteLine($"Could not load eBay fee settings: {ex.Message}"); }

        if (Id.HasValue)
        {
            try
            {
                var existing = await ListingService.GetListingAsync(Id.Value);
                // Populate the existing listing instance rather than replacing it (preserve editor DOM)
                listing.EbayAccountId = existing.EbayAccountId;
                // Accounts it's already published to (besides its main account) stay ticked for re-sync.
                alsoPublishTo = existing.Publications
                    .Where(p => p.Status == PublicationStatuses.Published && p.AccountId != existing.EbayAccountId)
                    .Select(p => p.AccountId)
                    .ToHashSet();
                listing.SupplierProductId = existing.SupplierProductId;
                listing.Title = existing.Title;
                listing.Description = existing.Description;
                listing.Price = existing.Price;
                listing.Quantity = existing.Quantity < 1 ? 1 : existing.Quantity;
                listing.Sku = existing.Sku;
                listing.CategoryId = existing.CategoryId;
                listing.CategoryName = existing.CategoryName;
                listing.FulfillmentPolicyId = existing.FulfillmentPolicyId;
                listing.PaymentPolicyId = existing.PaymentPolicyId;
                listing.ReturnPolicyId = existing.ReturnPolicyId;
                listing.SourceUrl = existing.SourceUrl;
                listing.Type = existing.Type;
                listing.Brand = existing.Brand;
                listing.Colour = existing.Colour;
                listing.ImageUrls = existing.ImageUrls ?? new List<string>();
                listingStatus = existing.Status;
                publicationLinks = existing.Publications;
                extractionUrl = existing.SourceUrl ?? "";

                // If the editor was already initialized, set its content now
                if (isQuillReady && !string.IsNullOrEmpty(listing.Description))
                {
                    await JS.InvokeVoidAsync("quillInterop.setHtml", quillElement, listing.Description);
                }

                listing.SourcePrice = existing.SourcePrice;
                listing.SourceStockLevel = existing.SourceStockLevel;
                listing.SourceProductCode = existing.SourceProductCode;
                CopyExtras(existing);

                // An Admin editing another user's listing publishes it with the owner's eBay account.
                var me = AuthService.CurrentUser;
                if (me != null && existing.OwnerUserId != me.Id && existing.OwnerUserId > 0)
                {
                    ownerEmail = existing.OwnerEmail ?? $"user #{existing.OwnerUserId}";
                    if (me.CanManageUsers)
                    {
                        try
                        {
                            ebayAccounts = await ListingService.GetEbayAccountsAsync(existing.OwnerUserId);
                            // Policies are loaded for this account, so it must be the owner's.
                            listing.EbayAccountId ??= ebayAccounts.FirstOrDefault(a => a.IsDefault)?.Id ?? ebayAccounts.FirstOrDefault()?.Id;
                        }
                        catch (Exception ex) { Console.WriteLine($"Could not load the owner's eBay accounts: {ex.Message}"); }
                    }
                }

                await LoadSupplierStatus();
                await LoadSupplierContext();
                await LoadCategoryAspects();

                Console.WriteLine($"[Edit] Loaded Listing {Id}: Payment={listing.PaymentPolicyId}, Shipping={listing.FulfillmentPolicyId}, Returns={listing.ReturnPolicyId}, SourceUrl={listing.SourceUrl}");
            }
            catch (Exception)
            {
                Navigation.NavigateTo("/");
            }
        }

        await LoadPolicies();
    }

    private async Task ResetFromSource()
    {
        if (!Id.HasValue)
        {
            return;
