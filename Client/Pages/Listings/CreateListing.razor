    private void AddImageUrl()
    {
        if (!string.IsNullOrWhiteSpace(newImageUrl))
        {
            if (!listing.ImageUrls.Contains(newImageUrl))
            {
                listing.ImageUrls.Add(newImageUrl);
            }
            newImageUrl = "";
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        const long maxBytes = 5 * 1024 * 1024;
        imageUploadError = null;
        var skipped = new List<string>();

        IReadOnlyList<IBrowserFile> files;
        try
        {
            files = e.GetMultipleFiles(10); // Limit to 10 images
        }
        catch (InvalidOperationException)
        {
            imageUploadError = "You can upload up to 10 images at a time.";
            return;
        }

        foreach (var file in files)
        {
            if (file.ContentType is not ("image/jpeg" or "image/png"))
            {
                skipped.Add($"{file.Name} (only JPG/PNG supported)");
                continue;
            }
            if (file.Size > maxBytes)
            {
                skipped.Add($"{file.Name} (over 5MB)");
                continue;
            }

            try
            {
                // ReadAsync on a browser stream can return partial chunks; copy the whole stream.
                await using var stream = file.OpenReadStream(maxBytes);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var dataUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";

                if (!listing.ImageUrls.Contains(dataUrl))
                {
                    listing.ImageUrls.Add(dataUrl);
                }
            }
            catch (Exception ex)
            {
                skipped.Add($"{file.Name} ({ex.Message})");
            }
        }

        if (skipped.Any())
        {
            imageUploadError = "Skipped: " + string.Join(", ", skipped);
        }
    }

    private async Task LoadPolicies()
    {
        policiesError = null;
        try
        {
            paymentPolicies = await ListingService.GetPaymentPoliciesAsync(listing.EbayAccountId);
            fulfillmentPolicies = await ListingService.GetFulfillmentPoliciesAsync(listing.EbayAccountId);
            returnPolicies = await ListingService.GetReturnPoliciesAsync(listing.EbayAccountId);

            // Auto-select defaults for NEW listings only (not edits)
            if (!Id.HasValue)
            {
                try
                {
                    var defaults = await ListingService.GetDefaultPoliciesAsync();

                    if (!string.IsNullOrEmpty(defaults.PaymentPolicyId))
                    {
                        listing.PaymentPolicyId = defaults.PaymentPolicyId;
                        if (!paymentPolicies.Any(p => p.PolicyId == defaults.PaymentPolicyId))
                        {
                            paymentPolicies.Insert(0, new EbayPolicyDto { PolicyId = defaults.PaymentPolicyId, Name = "Default (configured)" });
                        }
                    }
                    else if (string.IsNullOrEmpty(listing.PaymentPolicyId))
                    {
                        listing.PaymentPolicyId = paymentPolicies.FirstOrDefault(p => p.Name.Contains("Standard", StringComparison.OrdinalIgnoreCase))?.PolicyId;
                    }

                    if (!string.IsNullOrEmpty(defaults.FulfillmentPolicyId))
                    {
                        listing.FulfillmentPolicyId = defaults.FulfillmentPolicyId;
                        if (!fulfillmentPolicies.Any(p => p.PolicyId == defaults.FulfillmentPolicyId))
                        {
                            fulfillmentPolicies.Insert(0, new EbayPolicyDto { PolicyId = defaults.FulfillmentPolicyId, Name = "Default (configured)" });
                        }
                    }
                    else if (string.IsNullOrEmpty(listing.FulfillmentPolicyId))
                    {
                        listing.FulfillmentPolicyId = fulfillmentPolicies.FirstOrDefault(p => p.Name.Contains("Royal Mail 48", StringComparison.OrdinalIgnoreCase))?.PolicyId;
                    }

                    if (!string.IsNullOrEmpty(defaults.ReturnPolicyId))
                    {
                        listing.ReturnPolicyId = defaults.ReturnPolicyId;
                        if (!returnPolicies.Any(p => p.PolicyId == defaults.ReturnPolicyId))
                        {
                            returnPolicies.Insert(0, new EbayPolicyDto { PolicyId = defaults.ReturnPolicyId, Name = "Default (configured)" });
                        }
                    }
                    else if (string.IsNullOrEmpty(listing.ReturnPolicyId))
                    {
                        listing.ReturnPolicyId = returnPolicies.FirstOrDefault(p => p.Name.Contains("Returns Accepted", StringComparison.OrdinalIgnoreCase))?.PolicyId;
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error fetching default policies: {ex.Message}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading policies: {ex.Message}");
            policiesError = ex.Message;
        }
    }

    private async Task LoadEbayAccounts()
    {
        try
        {
            ebayAccounts = await ListingService.GetEbayAccountsAsync();
            if (!Id.HasValue && !listing.EbayAccountId.HasValue)
            {
                listing.EbayAccountId = ebayAccounts.FirstOrDefault(a => a.IsDefault)?.Id ?? ebayAccounts.FirstOrDefault()?.Id;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading eBay accounts: {ex.Message}");
            ebayAccounts = new List<EbayAccountDto>();
        }
    }

    private async Task OnEbayAccountChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        listing.EbayAccountId = int.TryParse(value, out var accountId) ? accountId : null;
        await LoadPolicies();
        await LoadCategoryAspects();
        suggestions.Clear();
        suggestStatusMessage = null;
    }

    private async Task LoadSupplierStatus()
    {
        if (!Id.HasValue) return;

        try
        {
            supplierStatus = await ListingService.GetSupplierStatusAsync(Id.Value);
            supplierStatusError = supplierStatus.IsSuccess ? null : supplierStatus.ErrorMessage;
        }
        catch (Exception ex)
        {
            supplierStatusError = $"Could not load supplier status: {ex.Message}";
        }
    }

    private async Task CheckSupplierStatus()
    {
        if (!CanCheckSupplier()) return;

        isCheckingSupplier = true;
        supplierStatusError = null;
        try
        {
            if (Id.HasValue)
            {
                supplierStatus = await ListingService.RefreshSupplierStatusAsync(Id.Value);
            }
            else
            {
                supplierStatus = await ListingService.CheckSupplierStatusAsync(listing.SourceUrl, listing.SourceProductCode);
            }

            if (!supplierStatus.IsSuccess)
            {
                supplierStatusError = supplierStatus.ErrorMessage ?? "Supplier check completed with warnings.";
            }
            else if (supplierStatus.StockLevel.HasValue)
            {
                // Keep the form in step with the server so a later save doesn't write the old value back.
                listing.SourceStockLevel = supplierStatus.StockLevel;
            }
        }
        catch (Exception ex)
        {
            supplierStatusError = $"Supplier check failed: {ex.Message}";
        }
        finally
        {
            isCheckingSupplier = false;
        }
    }

    // The server decides which suppliers support live stock checks (see SupplierStockService).
    private bool CanCheckSupplier() => supplierContext?.SupportsStockCheck == true;

    private async Task HandleExtract()
    {
        if (string.IsNullOrWhiteSpace(extractionUrl)) return;

        isExtracting = true;
        extractionError = null;
        extractedCategory = null;
        extractedIncVat = 0;
        extractedExVat = 0;

        // Preserve the existing listing instance to avoid losing the editor DOM; reset fields in place
        var currentPolicies = new { 
            Payment = listing.PaymentPolicyId, 
            Fulfillment = listing.FulfillmentPolicyId, 
            Return = listing.ReturnPolicyId 
        };

        listing.Title = string.Empty;
        listing.Description = string.Empty;
        listing.Brand = string.Empty;
        listing.Type = string.Empty;
        listing.Colour = string.Empty;
        listing.ImageUrls = new List<string>();
        listing.Price = 0;
        listing.CategoryId = null;
        listing.CategoryName = null;
        listing.SourceUrl = extractionUrl;
        listing.PaymentPolicyId = currentPolicies.Payment;
        listing.FulfillmentPolicyId = currentPolicies.Fulfillment;
        listing.ReturnPolicyId = currentPolicies.Return;

        suggestions.Clear();

        try
        {
            var details = await ListingService.ExtractDetailsAsync(extractionUrl);
            if (!string.IsNullOrEmpty(details.Title))
            {
                listing.Title = details.Title;
                if (!Id.HasValue) listing.SourceTitle = details.Title; // original supplier title, for tracking
            }
            if (!string.IsNullOrEmpty(details.Description)) listing.Description = details.Description;
            if (!string.IsNullOrEmpty(details.Category))
            {
                extractedCategory = details.Category;
                if (string.IsNullOrWhiteSpace(listing.SupplierCategory)) listing.SupplierCategory = details.Category.Trim();
            }
            if (!string.IsNullOrEmpty(details.Brand)) listing.Brand = details.Brand;
            
            if (details.PriceIncVat.HasValue) 
            {
                extractedIncVat = details.PriceIncVat.Value;
                listing.Price = extractedIncVat; // Prioritize inc VAT for textbox
            }
            if (details.PriceExVat.HasValue) 
            {
                extractedExVat = details.PriceExVat.Value;
                if (listing.Price == 0) listing.Price = extractedExVat; // Fallback
            }

            var isEdenSource = !string.IsNullOrWhiteSpace(listing.SourceUrl)
                               && listing.SourceUrl.Contains("edenhorticulture.co.uk", StringComparison.OrdinalIgnoreCase);
            if (listing.Price == 0 && !isEdenSource) listing.Price = 0.99m; // Keep existing fallback for other domains
            
            if (details.ImageUrls != null && details.ImageUrls.Any())
            {
                listing.ImageUrls = details.ImageUrls.ToList();
            }

            // Set description into the Quill editor if ready
            if (!string.IsNullOrEmpty(details.Description))
            {
                listing.Description = details.Description;
                if (isQuillReady)
                {
                    await JS.InvokeVoidAsync("quillInterop.setHtml", quillElement, listing.Description);
                }
            }

            // Source product code (extracted). Do NOT auto-fill SourcePrice; users will enter Source Price manually.
            listing.SourceProductCode = details.ProductCode;
            
            // Keep the source URL on the listing (so it will be saved) but clear the input box
            extractionUrl = "";

            if (!Id.HasValue)
            {
                listing.DeliveryCost = null;
                listing.DeliveryOptionName = null;
                await LoadSupplierContext();
            }
        }
        catch (HttpRequestException ex)
        {
            // Network-level failure: the API itself could not be reached.
            extractionError = $"Could not reach the server: {ex.Message}";
            Console.WriteLine(ex);
        }
        catch (Exception ex)
        {
            extractionError = string.IsNullOrWhiteSpace(ex.Message)
                ? "Could not extract details."
                : ex.Message;
            Console.WriteLine(ex);
        }
        finally
        {
            isExtracting = false;
        }
    }

    private async Task HandleSuggestCategories()
    {
        if (string.IsNullOrWhiteSpace(listing.Title)) return;

        suggestStatusMessage = null;
        suggestions.Clear();

        if (!listing.EbayAccountId.HasValue)
        {
            suggestStatusCss = "text-warning";
            suggestStatusMessage = "Select a connected eBay account first, then try suggesting a category again.";
            return;
        }
        
        isSuggesting = true;
        try
        {
            suggestions = await ListingService.GetCategorySuggestionsAsync(listing.Title, listing.EbayAccountId);
            if (!suggestions.Any())
            {
                suggestStatusCss = "text-warning";
                suggestStatusMessage = "No category suggestions returned. Check your eBay account connection and try a more specific title.";
            }
        }
        catch (Exception ex)
        {
            suggestStatusCss = "text-danger";
            suggestStatusMessage = "Could not fetch category suggestions right now. Please try again.";
            Console.WriteLine($"Error fetching suggestions: {ex.Message}");
        }
        finally
        {
            isSuggesting = false;
        }
    }

    private async Task SelectSuggestion(CategorySuggestionDto suggestion)
    {
        listing.CategoryId = suggestion.CategoryId;
        listing.CategoryName = suggestion.CategoryName;
        suggestions.Clear();
        suggestStatusMessage = null;
        await LoadCategoryAspects();
    }

    // ---- eBay item specifics for the selected category
    private List<CategoryAspectDto> categoryAspects = new();
    private string? aspectsLoadedFor;
    private bool isLoadingAspects;
    private string? aspectsError;

    private async Task LoadCategoryAspects()
    {
        await LoadCategoryChain(); // for the fee estimate
        var categoryId = listing.CategoryId?.Trim();
        if (string.IsNullOrEmpty(categoryId))
        {
            categoryAspects = new();
            aspectsLoadedFor = null;
            aspectsError = null;
            return;
        }
        if (categoryId == aspectsLoadedFor) return;
        if (!listing.EbayAccountId.HasValue)
        {
            categoryAspects = new();
            aspectsLoadedFor = null;
            aspectsError = "Select an eBay account to load the item specifics for this category.";
            return;
        }

        isLoadingAspects = true;
        aspectsError = null;
        try
        {
            categoryAspects = await ListingService.GetCategoryAspectsAsync(categoryId, listing.EbayAccountId);
            aspectsLoadedFor = categoryId;
        }
        catch (Exception ex)
        {
            // Not fatal: the listing can still be saved and published; eBay will report missing specifics.
            categoryAspects = new();
            aspectsError = $"Couldn't load item specifics for category {categoryId}: {ex.Message}";
        }
        finally
        {
            isLoadingAspects = false;
        }
    }

    private void OnCategoryIdInput(ChangeEventArgs e)
    {
        var newCategoryId = e.Value?.ToString();
        if (!string.Equals(listing.CategoryId, newCategoryId, StringComparison.Ordinal))
        {
            listing.CategoryId = newCategoryId;
            listing.CategoryName = null;
        }
    }

    private async Task HandleValidSubmit()
    {
        // If Quill is available, read HTML from it into listing.Description
        if (isQuillReady)
        {
            listing.Description = await JS.InvokeAsync<string>("quillInterop.getHtml", quillElement);
        }

        saveError = null;
        saveMessage = null;
        isSaving = true;
        try
        {
            if (Id.HasValue)
            {
                await ListingService.UpdateListingAsync(Id.Value, listing);
                if (closeAfterSave) { Navigation.NavigateTo("/"); return; }
                saveMessage = $"Saved at {DateTime.Now:HH:mm}.";
            }
            else
            {
                var created = await ListingService.CreateListingAsync(listing);
                // A new draft continues on its edit page (full load: this component loads the listing on initialisation).
                Navigation.NavigateTo(closeAfterSave ? "/" : $"/edit-listing/{created.Id}", forceLoad: !closeAfterSave);
            }
        }
        catch (Exception ex)
        {
            saveError = $"Save failed: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task HandleSaveAndPublish()
    {
        // If Quill is available, read HTML from it into listing.Description
        if (isQuillReady)
        {
            listing.Description = await JS.InvokeAsync<string>("quillInterop.getHtml", quillElement);
        }

        // Warn (don't block) when eBay's required item specifics for the category are empty.
        var missingAspects = CategoryAspectsEditor.MissingRequired(categoryAspects, listing).ToList();
        if (missingAspects.Any())
        {
            var proceed = await JS.InvokeAsync<bool>("confirm",
                $"These item specifics are required by eBay for this category and are empty: {string.Join(", ", missingAspects)}.\n\neBay will probably reject the listing. Publish anyway?");
            if (!proceed) return;
        }

        // Warn when the estimated profit is below the minimum set in the eBay fee settings.
        var estimate = EstimateFor(listing.Price, listing.SourcePrice);
        if (feeSettings != null && estimate.Profit.HasValue && estimate.Profit.Value < feeSettings.MinProfit
            && !await JS.InvokeAsync<bool>("confirm", $"Estimated profit is £{estimate.Profit.Value:F2} per sale, below your minimum of £{feeSettings.MinProfit:F2}. Publish anyway?"))
        {
            return;
        }

        isPublishing = true;
        publishProgress = null;
        publishWarnings = new();
        publishStatus = "Step 1/2: Saving local changes...";
        publishStatusShort = "Saving...";
        StateHasChanged();

        try
        {
            int listingId;
            if (Id.HasValue)
            {
                await ListingService.UpdateListingAsync(Id.Value, listing);
                listingId = Id.Value;
            }
            else
            {
                var newListing = await ListingService.CreateListingAsync(listing);
                listingId = newListing.Id;
            }

            publishStatus = "Step 2/2: Publishing to eBay... This may take a few seconds.";
            publishStatusShort = "Publishing...";
            StateHasChanged();

            var published = await ListingService.PublishListingWithProgressAsync(listingId, async progress =>
            {
                publishProgress = progress;
                await InvokeAsync(StateHasChanged);
            }, PublishAccountIds());
            publishProgress = await ListingService.GetPublishProgressAsync(listingId) ?? publishProgress;
            publishWarnings = published.PublishWarnings ?? new();
            publicationLinks = published.Publications ?? new();

            if (publishWarnings.Count > 0)
            {
                // Stay on the page so the missing pictures can be read.
                publishStatus = "Success! Listing published on eBay, with warnings (see below). ✅";
                StateHasChanged();
                return;
            }

            publishStatus = "Success! Listing updated on eBay. ✅";
            StateHasChanged();

            await Task.Delay(2000);
            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            publishStatus = $"Error: {ex.Message} ❌";
            if (publishProgress != null)
            {
                try { publishProgress = await ListingService.GetPublishProgressAsync(publishProgress.ListingId) ?? publishProgress; }
                catch { /* display only */ }
            }
        }
        finally
        {
            isPublishing = false;
        }
    }

