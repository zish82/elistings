@page "/create-listing"
@page "/edit-listing/{Id:int}"
@using Shared
@using Client.Services
@inject AuthService AuthService
@inject ListingService ListingService
@inject NavigationManager Navigation
@inject IJSRuntime JS


<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1">@(Id.HasValue ? "Edit Listing" : "Create New Listing")</h3>
            @foreach (var pub in publicationLinks.Where(p => p.Status == PublicationStatuses.Published && !string.IsNullOrEmpty(p.ListingUrl)))
            {
                <a class="badge bg-info text-dark text-decoration-none me-1" href="@pub.ListingUrl" target="_blank" rel="noopener">
                    View on @pub.Marketplace (@pub.AccountName) <i class="bi bi-box-arrow-up-right"></i>
                </a>
            }
        </div>
        <div class="d-flex gap-2">
            @if (Id.HasValue && listing.SupplierProductId.HasValue)
            {
                <button type="button" class="btn btn-outline-info" @onclick="FetchSupplierDetails" disabled="@isFetchingDetails"
                        title="Fetch description, specifications and images from the supplier website and fill any empty fields">
                    @if (isFetchingDetails)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                        <span class="ms-1">Fetching...</span>
                    }
                    else
                    {
                        <span>Fetch Missing Details</span>
                    }
                </button>
                <button type="button" class="btn btn-outline-warning" @onclick="ResetFromSource" disabled="@isResettingFromSource">
                    @if (isResettingFromSource)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                        <span class="ms-1">Resetting...</span>
                    }
                    else
                    {
                        <span>Reset from Source Product</span>
                    }
                </button>
            }
            <a href="/" class="btn btn-outline-secondary">Back to Dashboard</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(detailsMessage))
    {
        <div class="alert alert-info alert-dismissible small py-2">
            @detailsMessage
            <button type="button" class="btn-close" @onclick='() => detailsMessage = null'></button>
        </div>
    }

    <!-- URL Extraction UI -->
    <div class="card mb-4 bg-light">
        <div class="card-body">
            <h5 class="card-title">Quick Fill from URL</h5>
            <p class="card-text small text-muted">Paste a product URL to automatically extract Title and Description.</p>
            <div class="input-group">
                <input type="text" class="form-control" @bind="extractionUrl" placeholder="https://example.com/product..." />
                <button class="btn btn-primary" type="button" @onclick="HandleExtract" disabled="@isExtracting">
                    @if (isExtracting)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span class="ms-1">Fetching...</span>
                    }
                    else
                    {
                        <span>Extract Details</span>
                    }
                </button>
            </div>
            @if (!string.IsNullOrEmpty(listing.SourceUrl))
            {
                <div class="small mt-2">Listing URL: <a href="@listing.SourceUrl" target="_blank">@listing.SourceUrl</a></div>
            }
            @if (!string.IsNullOrEmpty(extractionError))
            {
                <div class="text-danger small mt-2">@extractionError</div>
            }
        </div>
    </div>

    <EditForm Model="@listing" OnValidSubmit="HandleValidSubmit" class="row g-3">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="col-md-12">
            <label for="title" class="form-label">Product Title</label>
            <div class="input-group">
                @* Plain input bound on every keystroke so the character counter updates while typing. *@
                <input id="title" class="form-control @(TitleLength > TitleMaxLength ? "is-invalid" : "")" @bind="listing.Title" @bind:event="oninput" required />
                <button class="btn btn-outline-info" type="button" @onclick="HandleSuggestCategories" disabled="@(isSuggesting || string.IsNullOrWhiteSpace(listing.Title))">
                    @if (isSuggesting)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                    }
                    else
                    {
                        <span>✨ Suggest Category</span>
                    }
                </button>
            </div>
            <div class="d-flex justify-content-between small mt-1">
                <span class="text-muted">
                    Formula: <strong>Brand</strong> + <strong>what it is</strong> + <strong>key attributes</strong> (size, colour, material, quantity) + <strong>use/occasion</strong>.
                    Put buyer search words first; only true facts; no symbols or filler words.
                </span>
                <span class="ms-2 text-nowrap @(TitleLength > TitleMaxLength ? "text-danger fw-bold" : TitleLength >= 65 ? "text-success" : "text-muted")">@TitleLength/@TitleMaxLength</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(listing.SourceTitle) && listing.SourceTitle != listing.Title)
            {
                <div class="small text-muted mt-1">Original supplier title: <em>@listing.SourceTitle</em></div>
            }
            @if (suggestions.Any())
            {
                <div class="mt-2 p-2 border rounded bg-white shadow-sm">
                    <div class="small text-muted mb-2">Select a suggested category:</div>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var s in suggestions)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary text-start" @onclick="() => SelectSuggestion(s)">
                                <strong>@s.CategoryId</strong> - @s.CategoryName
                                <br/><small class="text-muted">@string.Join(" > ", s.CategoryPath)</small>
                            </button>
                        }
                    </div>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(suggestStatusMessage))
            {
                <div class="small mt-2 @suggestStatusCss">@suggestStatusMessage</div>
            }
        </div>

        <div class="col-md-12">
            <div class="p-3 border rounded bg-white shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="mb-0">Price &amp; Delivery</h6>
                    @if (supplierContext?.Supplier != null)
                    {
                        <span class="small text-muted">
                            Supplier: <strong>@supplierContext.Supplier.Name</strong>
                            (@(supplierContext.Supplier.PricesIncludeVat ? "prices inc VAT" : $"prices ex VAT, +{supplierContext.Supplier.VatRatePercent:0.#}% VAT"))
                            @if (!string.IsNullOrWhiteSpace(supplierContext.PostageCategory)) { <span> · Postage: @supplierContext.PostageCategory</span> }
                        </span>
                    }
                </div>

                @if (Id.HasValue)
                {
                    <ListingVariantsEditor ListingId="Id.Value" DefaultPrice="listing.Price" DefaultQuantity="listing.Quantity"
                                           @bind-Selected="selectedVariant" RowsChanged="OnVariantRowsChanged" />
                }

                <div class="row g-3">
                    <div class="col-md-3">
                        @if (selectedVariant != null)
                        {
                            <label for="variantPrice" class="form-label">Item Price (inc VAT) · <span class="text-primary">@(string.IsNullOrWhiteSpace(selectedVariant.Value) ? "(unnamed)" : selectedVariant.Value)</span></label>
                            <input id="variantPrice" type="number" step="0.01" class="form-control" @bind="selectedVariant.Price" />
                            <div class="small text-muted mt-1">
                                Variation price; keep it with <em>Save variations</em>.
                                <a href="javascript:void(0)" @onclick="() => selectedVariant = null">Back to listing price</a>
                            </div>
                        }
                        else
                        {
                            <label for="price" class="form-label">Item Price (inc VAT)</label>
                            <InputNumber id="price" class="form-control" @bind-Value="listing.Price" step="0.01" />
                        }
                        @if (extractedIncVat > 0 || extractedExVat > 0)
                        {
                            <div class="small mt-1 text-muted">
                                @if (extractedIncVat > 0) { <span>Extracted inc VAT: £@extractedIncVat</span> }
                                @if (extractedExVat > 0) { <span class="d-block">Extracted ex VAT: £@extractedExVat</span> }
                            </div>
                        }
                        @if (SuggestedItemPrice.HasValue)
                        {
                            <div class="small mt-1">
                                <a href="javascript:void(0)" @onclick="() => SetDisplayedPrice(SuggestedItemPrice.Value)">Use suggested £@SuggestedItemPrice.Value.ToString("F2")</a>
                                <span class="text-muted">(@(SuggestedPick.Source == PricingMath.SourceWebsite ? "supplier website price" : $"cost + {supplierContext?.Supplier?.DefaultMarginPercent.ToString("0.#") ?? "20"}% margin"))</span>
                            </div>
                        }
                        <ValidationMessage For="@(() => listing.Price)" />
                    </div>

                    <div class="col-md-4">
                        <label for="deliveryOption" class="form-label">Delivery Option</label>
                        <select id="deliveryOption" class="form-select" value="@(selectedDeliveryOptionId?.ToString() ?? "")" @onchange="OnDeliveryOptionChanged">
                            <option value="">-- Custom / none --</option>
                            @foreach (var o in DeliveryOptions)
                            {
                                <option value="@o.Id">@o.Name (£@DeliveryGross(o).ToString("F2"))@(o.Id == supplierContext?.SuggestedDeliveryOptionId ? " - suggested" : "")</option>
                            }
                        </select>
                        @if (supplierContext?.Supplier == null)
                        {
                            <div class="small text-muted mt-1">No supplier matched; enter the delivery cost manually or set suppliers up on <a href="/suppliers">Suppliers &amp; Delivery</a>.</div>
                        }
                    </div>

                    <div class="col-md-2">
                        <label for="deliveryCost" class="form-label">Delivery Cost (inc VAT)</label>
                        <InputNumber id="deliveryCost" class="form-control" @bind-Value="listing.DeliveryCost" step="0.01" />
                        <ValidationMessage For="@(() => listing.DeliveryCost)" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Listing Total</label>
                        <div class="form-control bg-light fw-bold">£@ListingTotal.ToString("F2")</div>
                        <div class="form-check mt-1">
                            <input class="form-check-input" type="checkbox" id="includeDelivery" checked="@listing.IncludeDeliveryInPrice" disabled />
                            <label class="form-check-label small" for="includeDelivery">Include delivery in listing price</label>
                        </div>
                    </div>
                </div>

                <div class="alert alert-warning small py-2 mt-2 mb-2">
                    Delivery is always included in the listing price for now (listed with free postage); charging postage separately isn't implemented yet.
                </div>

                @if (feeSettings != null)
                {
                    var est = FeeEstimate;
                    <div class="border rounded p-2 small bg-light">
                        <div class="fw-semibold mb-1">Estimated profit per sale@(selectedVariant != null ? $" · {(string.IsNullOrWhiteSpace(selectedVariant.Value) ? "(unnamed)" : selectedVariant.Value)}" : "")</div>
                        <table class="table table-sm table-borderless mb-1" style="max-width: 460px;">
                            <tbody>
                                <tr><td>Buyer pays (item + delivery)</td><td class="text-end">£@est.SaleTotal.ToString("F2")</td></tr>
                                @if (est.SalesVat > 0)
                                {
                                    <tr><td>− VAT on the sale</td><td class="text-end">£@est.SalesVat.ToString("F2")</td></tr>
                                }
                                <tr>
                                    <td>− eBay fees
                                        <span class="text-muted">(final value £@est.FinalValueFee.ToString("F2") + order £@est.PerOrderFee.ToString("F2") + regulatory £@est.RegulatoryFee.ToString("F2")@(est.VatOnFees > 0 ? $" + VAT £{est.VatOnFees:F2}" : ""))</span>
                                        <div class="text-muted">Rate: @(est.RateDescription ?? $"default {est.FinalValueFeePercent:0.##}%")</div>
                                    </td>
                                    <td class="text-end">£@est.TotalFees.ToString("F2")</td>
                                </tr>
                                <tr>
                                    <td>− Item cost @(feeSettings.VatRegistered ? "(ex VAT)" : "(inc VAT)")</td>
                                    <td class="text-end">@(est.ItemCost.HasValue ? $"£{est.ItemCost.Value:F2}" : "enter Source Price")</td>
                                </tr>
                                <tr><td>− Delivery</td><td class="text-end">£@est.DeliveryCost.ToString("F2")</td></tr>
                                <tr class="border-top">
                                    <td class="fw-semibold">= Profit</td>
                                    <td class="text-end fw-bold @(!est.Profit.HasValue ? "" : est.Profit < feeSettings.MinProfit ? "text-danger" : "text-success")">
                                        @(est.Profit.HasValue ? $"£{est.Profit.Value:F2}" : "-")
                                        @if (est.MarginPercent.HasValue)
                                        {
                                            <span class="fw-normal text-muted">(@est.MarginPercent.Value.ToString("0.#")%)</span>
                                        }
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        @if (est.Profit.HasValue && est.Profit.Value < feeSettings.MinProfit)
                        {
                            <div class="text-danger">Below your minimum profit of £@feeSettings.MinProfit.ToString("F2").</div>
                        }
                        <div class="text-muted">
                            Estimate from your eBay fee settings (<a href="/suppliers">Suppliers &amp; Delivery</a>)@(string.IsNullOrWhiteSpace(listing.CategoryId) ? "; set the eBay category for its exact rate" : "").
                            eBay works out the real fee when the item sells.
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="col-md-8">
            <label for="ebayAccount" class="form-label">eBay Account</label>
            <select id="ebayAccount" class="form-select" value="@(listing.EbayAccountId?.ToString() ?? string.Empty)" @onchange="OnEbayAccountChanged">
                <option value="">-- Select eBay Account --</option>
                @foreach (var account in ebayAccounts)
                {
                    <option value="@account.Id">@account.Name@(account.IsDefault ? " (Default)" : string.Empty)@(account.IsShared ? " (shared)" : string.Empty)</option>
                }
            </select>
            @if (ebayAccounts.Count > 1 && listing.EbayAccountId.HasValue)
            {
                <div class="mt-2">
                    <span class="small me-2">Also publish to:</span>
                    @foreach (var account in ebayAccounts.Where(a => a.Id != listing.EbayAccountId))
                    {
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="also-@account.Id" checked="@alsoPublishTo.Contains(account.Id)"
                                   @onchange="e => ToggleAlsoPublish(account.Id, e.Value is true)" />
                            <label class="form-check-label small" for="also-@account.Id">@account.Name@(account.IsShared ? " (shared)" : string.Empty)</label>
                        </div>
                    }
                    <div class="small text-muted">Same price and quantity on every account. Business policies are matched by name on each account.</div>
                </div>
            }
            @if (ownerEmail != null)
            {
                <div class="small text-info mt-1">
                    This listing belongs to <strong>@ownerEmail</strong>.
                    @(AuthService.CurrentUser?.CanManageUsers == true
                        ? "It's published with one of their eBay accounts (listed above)."
                        : "Only they or an Admin can publish it.")
                </div>
            }
            else
            {
                <div class="small text-muted mt-1">Drafts default to your default account, but you can override it for this listing.</div>
            }
        </div>

        <div class="col-md-4">
            <label for="sku" class="form-label">SKU</label>
            <InputText id="sku" class="form-control" @bind-Value="listing.Sku" placeholder="Generated on save, e.g. DSM-S16301"
                       readonly="@IsPublished" maxlength="50" />
            <div class="small text-muted mt-1">
                @(IsPublished ? "SKU can't be changed after publishing." : "Leave blank to generate {supplier prefix}-{supplier code}. Saved in upper case; letters, numbers, - and _ only (max 50).")
            </div>
            <ValidationMessage For="@(() => listing.Sku)" />
        </div>

        <div class="col-md-4">
            <label for="quantity" class="form-label">Quantity</label>
            <InputNumber id="quantity" class="form-control" @bind-Value="listing.Quantity" min="1" step="1" />
            <ValidationMessage For="@(() => listing.Quantity)" />
        </div>

        <div class="col-md-8">
            <label for="category" class="form-label">eBay Category ID</label>
            <input id="category" class="form-control" value="@listing.CategoryId" @oninput="OnCategoryIdInput" @onblur="LoadCategoryAspects" placeholder="e.g. 57013" />
            <div class="small mt-1">
                <span class="text-muted">Need to find an ID? </span>
                <a href="https://www.ebay.co.uk/n/all-categories" target="_blank" class="text-decoration-none small">eBay UK Category Tree</a>
            </div>

            <label for="categoryName" class="form-label mt-3">eBay Category Name</label>
            <InputText id="categoryName" class="form-control" @bind-Value="listing.CategoryName" placeholder="Auto-filled from Suggest Category (or enter manually)" />

            @if (suggestions.Any())
            {
                <div class="mt-2 p-2 bg-light border rounded small text-muted">
                    Category suggestions were found from your title. Click one above to auto-fill this field.
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(listing.CategoryId))
            {
                <div class="mt-2 p-2 bg-light border rounded small text-muted">
                    Current category: <strong>@listing.CategoryId</strong>@(string.IsNullOrWhiteSpace(listing.CategoryName) ? string.Empty : $" - {listing.CategoryName}")
                </div>
            }
            else
            {
                <div class="mt-2 p-2 bg-light border rounded small text-muted">
                    Use Suggest Category for this listing title, or enter the eBay category ID manually.
                </div>
            }
            
            @if (!string.IsNullOrWhiteSpace(listing.SupplierCategory))
            {
                <div class="mt-2 small text-muted" title="The supplier's own category, used to group products and listings. Not sent to eBay.">
                    <strong>Supplier category:</strong> @listing.SupplierCategory
                </div>
            }
        </div>

        <div class="col-md-4">
            <label for="brand" class="form-label">Brand</label>
            <InputText id="brand" class="form-control" @bind-Value="listing.Brand" placeholder="e.g. Generic" />
        </div>

        <div class="col-md-4">
            <label for="sourcePrice" class="form-label">Source Price</label>
            <InputNumber id="sourcePrice" class="form-control" @bind-Value="listing.SourcePrice" step="0.01" />
            <div class="small text-muted">Supplier's price as listed by the supplier (@(supplierContext?.Supplier is { PricesIncludeVat: false } ? "ex VAT" : "inc VAT")); used for cost and margin.</div>
        </div>

        <div class="col-md-4">
            <label for="sourceCode" class="form-label">Source Product Code</label>
            <InputText id="sourceCode" class="form-control" @bind-Value="listing.SourceProductCode" />
        </div>

        <div class="col-md-12">
            <div class="p-3 border rounded bg-light">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="CheckSupplierStatus" disabled="@(isCheckingSupplier || !CanCheckSupplier())">
                        @if (isCheckingSupplier)
                        {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                            <span class="ms-1">Checking supplier...</span>
                        }
                        else
                        {
                            <span>Check Current Supplier Stock</span>
                        }
                    </button>
                    @if (!CanCheckSupplier())
                    {
                        <span class="small text-muted">Live stock checks aren't available for this listing's supplier (supported: DropShipMall, Eden Horticulture, Safelincs).</span>
                    }
                </div>

                @if (supplierStatus != null)
                {
                    <div class="small mt-2">
                        <div><strong>Supplier:</strong> @supplierStatus.Supplier</div>
                        <div><strong>SKU:</strong> @(string.IsNullOrWhiteSpace(supplierStatus.SupplierSku) ? "-" : supplierStatus.SupplierSku)</div>
                        <div><strong>Stock:</strong> @(supplierStatus.StockStatus == "Unknown" ? string.Empty : supplierStatus.StockStatus)@(string.IsNullOrWhiteSpace(supplierStatus.StockText) ? string.Empty : $" ({supplierStatus.StockText})")</div>
                        <div><strong>Supplier Price:</strong> @(supplierStatus.SupplierPrice.HasValue ? $"£{supplierStatus.SupplierPrice.Value:F2}" : "£0.00")</div>
                        <div><strong>Last Updated:</strong> @(supplierStatus.LastCheckedUtc.HasValue ? supplierStatus.LastCheckedUtc.Value.ToLocalTime().ToString("g") : "Not checked yet")</div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(supplierStatusError))
                {
                    <div class="small text-danger mt-2">@supplierStatusError</div>
                }
            </div>
        </div>

        <div class="col-md-4">
            <label for="type" class="form-label">Type (eBay Aspect)</label>
            <InputText id="type" class="form-control" @bind-Value="listing.Type" placeholder="e.g. Fire Extinguisher" />
        </div>

        <div class="col-md-4">
            <label for="colour" class="form-label">Colour (eBay Aspect)</label>
            <InputText id="colour" class="form-control" @bind-Value="listing.Colour" placeholder="e.g. Red, Black" />
        </div>

        <div class="col-md-4">
            <label for="barcode" class="form-label">Barcode (EAN/UPC)</label>
            <InputText id="barcode" class="form-control" @bind-Value="listing.Barcode" />
        </div>

        @if (listing.ItemSpecifics.Any())
        {
            <div class="col-md-12">
                <label class="form-label">Item Specifics <span class="small text-muted">(from supplier; sent to eBay)</span></label>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var kv in listing.ItemSpecifics.ToList())
                    {
                        <span class="badge bg-light text-dark border">
                            @kv.Key: @kv.Value
                            <button type="button" class="btn btn-sm p-0 ms-1 text-danger" style="line-height:1" @onclick="() => listing.ItemSpecifics.Remove(kv.Key)">&times;</button>
                        </span>
                    }
                </div>
            </div>
        }

        <div class="col-md-12">
            @if (isLoadingAspects)
            {
                <div class="small text-muted"><span class="spinner-border spinner-border-sm me-1"></span>Loading eBay item specifics for this category...</div>
            }
            else if (!string.IsNullOrWhiteSpace(aspectsError))
            {
                <div class="small text-warning">@aspectsError</div>
            }
            <CategoryAspectsEditor Listing="listing" Aspects="categoryAspects" OnChanged="StateHasChanged" />
        </div>

        <div class="col-md-12">
            <label class="form-label">Images</label>
            <div class="d-flex flex-wrap gap-2 mb-3 p-3 border rounded bg-light" style="min-height: 100px;">
                @if (listing.ImageUrls.Count == 0)
                {
                    <span class="text-muted small">No images added yet. Extract from URL or add manually.</span>
                }
                @foreach (var imageUrl in listing.ImageUrls)
                {
                    <div class="position-relative">
                        <img src="@imageUrl" class="rounded border shadow-sm" style="width: 100px; height: 100px; object-fit: cover;" />
                        <button type="button" class="btn btn-danger btn-sm position-absolute top-0 end-0 rounded-circle" 
                                style="line-height: 1; padding: 2px 6px; transform: translate(50%, -50%);"
                                @onclick="() => listing.ImageUrls.Remove(imageUrl)">
                            &times;
                        </button>
                    </div>
                }
            </div>

            <div class="input-group mb-3">
                <input type="text" class="form-control form-control-sm" @bind="newImageUrl" placeholder="Paste image URL here..." />
                <button class="btn btn-outline-primary btn-sm" type="button" @onclick="AddImageUrl">Add URL</button>
            </div>
            
            <div class="mb-3">
                <label for="imageUpload" class="form-label small text-muted">Or upload manual images (JPG, PNG)</label>
                <InputFile id="imageUpload" class="form-control form-control-sm" OnChange="HandleFileSelected" multiple accept="image/jpeg,image/png" />
                @if (!string.IsNullOrEmpty(imageUploadError))
                {
                    <div class="small text-danger mt-1">@imageUploadError</div>
                }
            </div>
        </div>

        <div class="col-md-12">
            <label id="description-label" for="description" class="form-label">Description (HTML / Rich Text)</label>
            <div id="description" @ref="quillElement" style="height: 300px;" class="border rounded shadow-sm"></div>
        </div>

        <div class="col-12 mt-4">
            <div class="p-4 border rounded bg-white shadow-sm">
                <h5 class="text-primary mb-3">eBay Business Policies</h5>
                <p class="small text-muted mb-4">Select your policies from the dropdowns below. These are fetched directly from your eBay account.</p>
                @if (!string.IsNullOrWhiteSpace(policiesError))
                {
                    <div class="alert alert-danger small text-break">@policiesError</div>
                }
                else if (listing.EbayAccountId.HasValue && !paymentPolicies.Any() && !fulfillmentPolicies.Any() && !returnPolicies.Any())
                {
                    <div class="alert alert-warning small">
                        This eBay account has no business policies for eBay UK yet. Create Payment, Postage and Returns policies in
                        eBay Seller Hub (Account &gt; Business policies), then reload this page.
                    </div>
                }
                
                <div class="row g-3">
                    <div class="col-md-4">
                        <label for="payment" class="form-label font-weight-bold">Payment Policy</label>
                        <InputSelect id="payment" class="form-select" @bind-Value="listing.PaymentPolicyId">
                            <option value="">-- Select Payment Policy --</option>
                            @foreach (var policy in paymentPolicies)
                            {
                                <option value="@policy.PolicyId">@policy.Name</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-md-4">
                        <label for="shipping" class="form-label font-weight-bold">Fulfillment Policy (Shipping)</label>
                        <InputSelect id="shipping" class="form-select" @bind-Value="listing.FulfillmentPolicyId">
                            <option value="">-- Select Shipping Policy --</option>
                            @foreach (var policy in fulfillmentPolicies)
                            {
                                <option value="@policy.PolicyId">@policy.Name</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-md-4">
                        <label for="return" class="form-label font-weight-bold">Return Policy</label>
                        <InputSelect id="return" class="form-select" @bind-Value="listing.ReturnPolicyId">
                            <option value="">-- Select Return Policy --</option>
                            @foreach (var policy in returnPolicies)
                            {
                                <option value="@policy.PolicyId">@policy.Name</option>
                            }
                        </InputSelect>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 mt-4 mb-5">
            <button type="submit" class="btn btn-success btn-lg px-4 shadow-sm" disabled="@isSaving" @onclick="() => closeAfterSave = false">
                @(Id.HasValue ? "Save Changes" : "Save as Draft")
            </button>
            <button type="submit" class="btn btn-outline-success btn-lg px-4 shadow-sm ms-2" disabled="@isSaving" @onclick="() => closeAfterSave = true">
                Save and Close
            </button>
            <button type="button" class="btn btn-primary btn-lg px-4 shadow-sm ms-2" 
                    @onclick="HandleSaveAndPublish" disabled="@isPublishing">
                @if (isPublishing)
                {
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                    <span class="ms-1">@publishStatusShort</span>
                }
                else
                {
                    @(Id.HasValue && listingStatus == "Published" ? "Save & Re-sync" : "Save & Publish")
                }
            </button>
            <a href="/" class="btn btn-link text-secondary ms-2">Discard Changes</a>

            @if (!string.IsNullOrEmpty(saveError))
            {
                <div class="mt-3 text-danger fw-bold">@saveError</div>
            }
            else if (!string.IsNullOrEmpty(saveMessage))
            {
                <div class="mt-3 text-success fw-bold">@saveMessage</div>
            }

            @if (!string.IsNullOrEmpty(publishStatus))
            {
                <div class="mt-3 p-3 rounded bg-white border shadow-sm d-block" style="max-width: 500px;">
                    @if (publishStatus.Contains("Success"))
                    {
                        <div class="text-success fw-bold"><i class="bi bi-check-circle-fill me-2"></i>@publishStatus</div>
                    }
                    else if (publishStatus.Contains("Error"))
                    {
                        <div class="text-danger fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>@publishStatus</div>
                    }
                    else
                    {
                        <div class="text-primary"><div class="spinner-border spinner-border-sm me-2" role="status"></div>@publishStatus</div>
                    }
                    @if (publishProgress != null || publishWarnings.Count > 0)
                    {
                        <div class="mt-2">
                            <PublishProgressPanel Progress="publishProgress" Warnings="publishWarnings" />
                        </div>
                        @if (!isPublishing && publishWarnings.Count > 0)
                        {
                            <a href="/" class="btn btn-sm btn-outline-secondary mt-2">Back to My Listings</a>
                        }
                    }
                </div>
            }
        </div>
    </EditForm>
</div>

@* eBay's fee API preview was replaced by the fee/profit estimate next to the price (see FeeEstimate). *@

@code {
