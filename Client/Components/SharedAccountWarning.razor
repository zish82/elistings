@using Shared
@* Shown when "Add to my listings" finds the product already posted on an account by another user. *@

@if (Conflicts.Count > 0)
{
    <div class="alert alert-warning" role="alert">
        <div class="fw-semibold mb-1"><i class="bi bi-exclamation-triangle-fill me-1"></i>Already posted on a shared account</div>
        <ul class="mb-2 ps-3">
            @foreach (var c in Conflicts)
            {
                <li><strong>@c.ProductTitle</strong> – @c.Message</li>
            }
        </ul>
        <button class="btn btn-sm btn-warning me-2" @onclick="OnAddAnyway" disabled="@Busy">Add anyway</button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="OnCancel" disabled="@Busy">Don't add</button>
    </div>
}

@code {
    [Parameter] public List<SharedAccountConflictDto> Conflicts { get; set; } = new();
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnAddAnyway { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
}
