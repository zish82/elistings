# Copy to .env (never commit .env) and fill in.
POSTGRES_DB=elistings
POSTGRES_USER=elistings
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# eListings app domain for HTTPS (server only), e.g. elistings.digitalclub.co.uk
DOMAIN=

ASPNETCORE_ENVIRONMENT=Production

EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_RUNAME=
EBAY_IS_SANDBOX=false

EDEN_USERNAME=
EDEN_PASSWORD=
DSM_USERNAME=
DSM_PASSWORD=

# Digital Club company website (server only), e.g. digitalclub.co.uk – DOMAIN above is then elistings.digitalclub.co.uk
SITE_DOMAIN=
# Email address shown on the website
SITE_CONTACT_EMAIL=

# Website contact form → email (leave CONTACT_TO_EMAIL or SMTP_HOST empty to switch the form off)
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
