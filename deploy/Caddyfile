# HTTPS for the eListings app and the Digital Club website. Values come from .env:
#   DOMAIN       eListings app, e.g. elistings.digitalclub.co.uk
#   SITE_DOMAIN  company website, e.g. digitalclub.co.uk (optional; unset = served only on site.localhost)
# The DNS A records of both (and www.SITE_DOMAIN) must point at this server.

# eListings app
{$DOMAIN} {
	encode gzip
	reverse_proxy app:8080
}

# Digital Club website (static files built by the "site" service into sites/digitalclub/dist)
{$SITE_DOMAIN:site.localhost} {
	encode gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	header /assets/* Cache-Control "public, max-age=86400"

	# Contact form: handled by the app, on the same domain as the site (so no CORS set-up is needed).
	handle /api/public/contact {
		reverse_proxy app:8080
	}

	# Product links on the company domain, e.g. /products/elistings → the app.
	handle /products/elistings* {
		redir https://{$DOMAIN}/login 302
	}

	handle {
		root * /srv/digitalclub
		file_server
	}
}

# www → bare domain
www.{$SITE_DOMAIN:site.localhost} {
	redir https://{$SITE_DOMAIN:site.localhost}{uri} 301
}
