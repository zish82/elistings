{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=app.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EbaySettings": {
    "AppId": "",
    "CertId": "",
    "DevId": "",
    "RuName": "Zeeshan_Ahmed-ZeeshanA-direct-csqwpsyr",
    "UserToken": "",
    "RedirectUri": "https://localhost:5197/api/auth/callback",
    "IsSandbox": false
  },
  "Scraper": {
    "ProxyUrlTemplate": "",
    "ProxyApiKey": "",
    "ProxyFallbackDomains": "safelincs.co.uk, edenhorticulture.co.uk, exampledomain.com"
  },
  "EdenSupplier": {
    "Enabled": true,
    "Username": "",
    "Password": "",
    "LoginPath": "/account/login"
  },
  "Hangfire": {
    "Storage": "SQLite"
  },
  // Sales report (/sales)
  "EbayOrders": {
    // How far back to import eBay orders: 120 ≈ 4 months; 730 = eBay's maximum of 2 years.
    "HistoryDays": 120,
    // true = import new/changed orders automatically on the schedule below (restart the app after changing).
    // false = only when you click "Sync now" on the Sales page.
    "AutoSyncEnabled": false,
    // When the automatic import runs (cron, UTC): "15 */2 * * *" = every 2 hours at quarter past.
    "AutoSyncCron": "15 */2 * * *"
  },
  // Digital Club website contact form (POST api/public/contact). Leave ToEmail or Smtp:Host empty to switch it off.
  // Put real values in appsettings.Development.json or env vars (Contact__ToEmail, Contact__Smtp__Password, …) – not here.
  "Contact": {
    // Where enquiries are emailed.
    "ToEmail": "",
    // Sender address allowed by your SMTP service (empty = Smtp:Username).
    "FromEmail": "",
    "FromName": "Digital Club website",
    // Only needed if the website is on a different domain from this app and isn't proxied, e.g. [ "https://digitalclub.example" ].
    "AllowedOrigins": [],
    // Messages accepted per visitor IP per hour.
    "MaxPerHourPerIp": 5,
    "Smtp": {
      "Host": "",
      // 587 = STARTTLS (usual), 465 = TLS from the start.
      "Port": 587,
      "Username": "",
      "Password": ""
    }
  },
  "RequestThrottle": {
    "edenhorticulture.co.uk": 2000,
    "safelincs.co.uk": 3000
  },
  "DropShipMall": {
    "Username": "",
    "Password": ""
  }
}
